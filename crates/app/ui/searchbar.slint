// 搜索条。输入框在左侧搜索图标和右侧应用墙按钮之间，结果在它下方展开。版式由这里决定，数据和动作在 Rust。

export struct BarRow {
    // 名称拆成三段，中间一段是与输入相同的部分，加粗。没有匹配时只有 head。
    label-head: string,
    label-match: string,
    label-tail: string,
    // 类型：应用、待办、便签、收纳、文件、文件夹、浏览器、网页搜索。
    kind: string,
    // 路径或所属分组。location-always 为真时总是显示，否则选中后才显示。
    location: string,
    location-always: bool,
    icon: image,
    has-icon: bool,
    // 没有图标时是否画类型图形。收纳里的网页引用为假，图标位留空。
    draw-glyph: bool,
    // 没有壳层图标时画的图形。0 应用，1 待办，2 便签，3 文件，4 文件夹，5 浏览器，6 网页搜索，7 地球。
    glyph: int,
    y: length,
    // 与上一行不在同一组。
    group-start: bool,
}

export struct BarMenuItem {
    label: string,
    hint: string,
    enabled: bool,
}

component Glyph inherits Rectangle {
    in property <int> glyph;
    in property <color> ink;
    in property <color> accent;

    width: 24px;
    height: 24px;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: glyph == 0 || glyph == 4 || glyph == 6 ? accent : ink;
        stroke-width: 1.5px;
        commands: glyph == 0 ? "M4.5 4.5h6v6h-6z M13.5 4.5h6v6h-6z M4.5 13.5h6v6h-6z M13.5 13.5h6v6h-6z"
            : glyph == 1 ? "M12 3.5a8.5 8.5 0 1 0 0.01 0z M8 12.3l2.8 2.8 5.4-5.6"
            : glyph == 2 ? "M5.5 3.5h13v17h-13z M8.5 8h7 M8.5 11.5h7 M8.5 15h4.5"
            : glyph == 3 ? "M6 3.5h8l4.5 4.5v12.5h-12.5z M14 3.5v4.5h4.5"
            : glyph == 4 ? "M3.5 6.5v12h17v-10h-9l-2-2z"
            : glyph == 6 ? "M10.5 4a6.5 6.5 0 1 0 0.01 0z M15.2 15.2l5.3 5.3"
            : glyph == 7 ? "M12 3.5a8.5 8.5 0 1 0 0.01 0z M3.5 12h17 M12 3.5c-3 3-3 14 0 17 M12 3.5c3 3 3 14 0 17"
            : "M12 3.5a8.5 8.5 0 1 0 0.01 0z M3.5 12h17 M12 3.5c-3 3-3 14 0 17 M12 3.5c3 3 3 14 0 17";
    }
}

export component SearchBar inherits Window {
    title: "Lanwork";
    icon: @image-url("../assets/lanwork-256.png");
    no-frame: true;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;

    in property <bool> dark;
    // 亚克力时客户区透明，DWM 画背景。
    in property <bool> acrylic;
    in property <color> solid-color: #f3f3f3;
    in property <[BarRow]> rows;
    in property <int> selected;
    in property <length> list-content-height;
    in property <length> max-list-height: 432px;
    // 结果区下方的一行：错误、「文件索引不可用」或「没有结果」。
    in property <string> status;
    in property <bool> status-is-error;
    // Alt+1 至 Alt+9 对应的行：first-shortcut 是 Alt+1，到 end-shortcut 之前为止。
    in property <int> first-shortcut;
    in property <int> end-shortcut;
    // 应用墙打开时结果不显示。窗口由 Rust 隐藏，右侧按钮随窗口离开屏幕，文字留在输入框。
    in property <bool> wall-open: false;

    callback edited(string);
    callback toggle-wall();
    callback escape();
    callback move-selection(bool);
    callback enter(bool, bool, bool, bool);
    // 选中文件夹时补全路径。返回真表示已经接住 Tab。
    callback complete-folder() -> bool;
    // 回到上一层。返回假时 Ctrl+Backspace 仍交给输入框。
    callback path-up() -> bool;
    // 指针在行上移动。坐标是窗口里的逻辑像素。静止指针下出现的结果不改选择，由 Rust 比较屏幕坐标。
    callback hover(int, length, length);
    // 单击某行，等同在该行上按 Enter。
    callback activate(int);
    // Alt+数字，参数 1 至 9。菜单开着时不调用，改走 menu-shortcut。
    callback shortcut(int);
    // 在有菜单的结果上松开右键。坐标是窗口里的逻辑像素。
    callback open-menu(int, length, length);
    // 光标在输入末尾时，右方向键打开当前选中结果的菜单。
    callback open-selected-menu();
    // 光标的 UTF-8 字节偏移是否落在已提交文本的末尾。
    callback caret-at-end(int) -> bool;
    // 菜单项下标，0 起。返回真表示菜单留着（例如换成收纳分组）。
    callback menu-activate(int) -> bool;
    // 菜单开着时的 Alt+数字，参数 1 至 9。
    callback menu-shortcut(int);
    in property <[BarMenuItem]> menu-items;
    in-out property <bool> menu-open: false;
    in-out property <length> menu-anchor-x: 0px;
    in-out property <length> menu-anchor-y: 0px;
    // 列表向上滚过的距离变了。
    callback scrolled(length);
    // 从输入框左侧的拖动条按下。不覆盖输入框和结果行。
    callback drag-window();

    out property <string> preedit: input.preedit-text;
    in-out property <string> text <=> input.text;

    property <length> input-height: 56px;
    property <length> pad: 6px;
    property <length> row-height: 48px;
    property <length> wall-slot: 48px;
    property <bool> has-list: rows.length > 0;
    property <bool> has-status: status != "";
    property <bool> show-results: !wall-open && (has-list || has-status);
    property <length> list-height: min(list-content-height, max-list-height);
    property <length> results-height: show-results ? 1px + (has-list ? list-height : 0px) + (has-status ? 36px : 0px) : 0px;
    property <length> natural-height: input-height + results-height;
    property <length> menu-width: 272px;
    property <length> menu-item-h: 36px;
    property <length> menu-pad: 4px;
    property <length> menu-block: menu-pad * 2 + menu-items.length * menu-item-h;
    property <bool> menu-shown: menu-open && menu-items.length > 0;
    property <length> menu-draw-x: min(max(8px, menu-anchor-x), max(8px, self.width - menu-width - 8px));
    property <length> menu-draw-y: menu-anchor-y + menu-block + 8px > natural-height && menu-anchor-y > menu-block
        ? max(8px, menu-anchor-y - menu-block)
        : max(8px, menu-anchor-y);
    out property <int> menu-hover: -1;

    property <color> ink: dark ? #ffffff : #1b1b1b;
    property <color> ink-secondary: dark ? #c5c5c5 : #5d5d5d;
    property <color> ink-tertiary: dark ? #9a9a9a : #767676;
    property <color> divider: dark ? #ffffff17 : #00000014;
    property <color> selection-fill: dark ? #ffffff14 : #0000000d;
    property <color> accent: dark ? #60cdff : #005fb8;
    property <color> critical: dark ? #ff99a4 : #c42b1c;

    width: 680px;
    height: menu-shown ? max(natural-height, menu-draw-y + menu-block + 8px) : natural-height;
    background: acrylic ? transparent : solid-color;

    changed menu-open => {
        menu-hover = -1;
    }

    public function focus-input() {
        input.focus();
    }

    public function select-all() {
        input.select-all();
    }

    // 让选中行留在可见范围里。
    public function ensure-visible() {
        if selected < 0 || selected >= rows.length {
            return;
        }
        if rows[selected].y - pad + list.content-y < 0px {
            list.content-y = -(rows[selected].y - pad);
        } else if rows[selected].y + row-height + pad + list.content-y > list.height {
            list.content-y = list.height - rows[selected].y - row-height - pad;
        }
    }

    public function scroll-to-top() {
        list.content-y = 0px;
    }

    // 换一批菜单项时清掉上一项的悬停。
    public function refresh-menu() {
        menu-hover = -1;
    }

    // 补全或回到上一层时换掉整段输入，光标停在末尾。`end` 是字节偏移。
    public function replace-input(value: string, end: int) {
        input.text = value;
        input.set-selection-offsets(end, end);
    }

    Path {
        x: 20px;
        y: (input-height - 18px) / 2;
        width: 18px;
        height: 18px;
        viewbox-width: 18;
        viewbox-height: 18;
        fill: transparent;
        stroke: ink-secondary;
        stroke-width: 1.6px;
        commands: "M7.5 1.5a6 6 0 1 0 0.01 0z M11.9 11.9l4.6 4.6";
    }

    // 临时拖动条：只盖住输入框左侧，宽度与下面输入框的 x 相同。不覆盖输入框和结果。
    TouchArea {
        x: 0px;
        y: 0px;
        width: 52px;
        height: input-height;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag-window();
            }
        }
    }

    input-clip := Rectangle {
        x: 52px;
        y: 0px;
        width: parent.width - 52px - wall-slot;
        height: input-height;
        clip: true;

        input := TextInput {
            property <length> computed-x;

            x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
            y: 0px;
            width: max(parent.width - self.text-cursor-width, self.preferred-width);
            height: 100%;
            single-line: true;
            font-size: 18px;
            color: ink;
            vertical-alignment: center;
            selection-background-color: dark ? #60cdff66 : #005fb855;
            selection-foreground-color: ink;

            cursor-position-changed(cursor-position) => {
                if cursor-position.x + self.computed-x < 0px {
                    self.computed-x = -cursor-position.x;
                } else if cursor-position.x + self.computed-x > parent.width - self.text-cursor-width {
                    self.computed-x = parent.width - cursor-position.x - self.text-cursor-width;
                }
            }

            key-pressed(event) => {
                if self.preedit-text != "" {
                    return reject;
                }
                if event.text == Key.Tab && !event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt && !event.modifiers.meta {
                    if root.complete-folder() {
                        return accept;
                    }
                }
                if event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text == Key.Backspace {
                    if root.path-up() {
                        return accept;
                    }
                }
                if event.text == Key.Escape {
                    if root.menu-open {
                        root.menu-open = false;
                        return accept;
                    }
                    root.escape();
                    return accept;
                }
                if event.text == Key.UpArrow {
                    root.move-selection(false);
                    return accept;
                }
                if event.text == Key.DownArrow {
                    root.move-selection(true);
                    return accept;
                }
                if event.text == Key.RightArrow && !event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt && !event.modifiers.meta {
                    if root.caret-at-end(self.cursor-position-byte-offset) {
                        if !root.menu-open {
                            root.open-selected-menu();
                        }
                        return accept;
                    }
                }
                if event.modifiers.alt && !event.modifiers.control && !event.modifiers.shift && !event.modifiers.meta
                    && event.text.character-count == 1 && event.text.is-float()
                    && event.text.to-float() >= 1 && event.text.to-float() <= 9 {
                    if root.menu-open {
                        root.menu-shortcut(round(event.text.to-float()));
                    } else {
                        root.shortcut(round(event.text.to-float()));
                    }
                    return accept;
                }
                if event.text == Key.Return {
                    root.enter(event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                    return accept;
                }
                reject
            }

            edited => {
                root.edited(self.text);
            }
        }
    }

    wall-button := TouchArea {
        x: parent.width - wall-slot;
        y: 0px;
        width: wall-slot;
        height: input-height;

        Rectangle {
            x: (parent.width - 32px) / 2;
            y: (parent.height - 32px) / 2;
            width: 32px;
            height: 32px;
            border-radius: 6px;
            background: root.wall-open || wall-button.has-hover ? selection-fill : transparent;
        }

        Path {
            x: (parent.width - 16px) / 2;
            y: (parent.height - 16px) / 2;
            width: 16px;
            height: 16px;
            viewbox-width: 16;
            viewbox-height: 16;
            fill: transparent;
            stroke: root.wall-open ? accent : ink-secondary;
            stroke-width: 1.4px;
            commands: "M1.5 1.5h5.5v5.5h-5.5z M9 1.5h5.5v5.5h-5.5z M1.5 9h5.5v5.5h-5.5z M9 9h5.5v5.5h-5.5z";
        }

        clicked => {
            root.toggle-wall();
        }
    }

    if show-results: Rectangle {
        x: 0px;
        y: input-height;
        width: parent.width;
        height: 1px;
        background: divider;
    }

    list := Flickable {
        x: 0px;
        y: input-height + 1px;
        width: parent.width;
        height: has-list ? list-height : 0px;
        content-width: self.width;
        content-height: root.list-content-height;
        visible: show-results && has-list;

        changed content-y => {
            root.scrolled(-self.content-y);
        }

        for row[index] in rows: Rectangle {
            property <bool> is-selected: index == selected;
            property <bool> two-line: row.location != "" && (row.location-always || is-selected);
            property <int> hint: index >= root.first-shortcut && index < root.end-shortcut ? index - root.first-shortcut + 1 : 0;

            x: 0px;
            y: row.y;
            width: parent.width;
            height: row-height;

            if row.group-start && index > 0: Rectangle {
                x: 20px;
                y: -5px;
                width: parent.width - 40px;
                height: 1px;
                background: divider;
            }

            Rectangle {
                x: 6px;
                width: parent.width - 12px;
                height: parent.height;
                border-radius: 6px;
                background: is-selected ? selection-fill : transparent;
            }

            if is-selected: Rectangle {
                x: 6px;
                y: (parent.height - 16px) / 2;
                width: 3px;
                height: 16px;
                border-radius: 1.5px;
                background: accent;
            }

            if row.has-icon: Image {
                x: 20px;
                y: (parent.height - 24px) / 2;
                width: 24px;
                height: 24px;
                source: row.icon;
                image-fit: contain;
            }

            if !row.has-icon && row.draw-glyph: Glyph {
                x: 20px;
                y: (parent.height - 24px) / 2;
                glyph: row.glyph;
                ink: ink-secondary;
                accent: accent;
            }

            HorizontalLayout {
                x: 56px;
                y: two-line ? 6px : 0px;
                width: parent.width - 56px - 152px;
                height: two-line ? 20px : parent.height;
                spacing: 0px;

                if row.label-head != "": Text {
                    horizontal-stretch: 0;
                    text: row.label-head;
                    color: ink;
                    font-size: 14px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if row.label-match != "": Text {
                    horizontal-stretch: 0;
                    text: row.label-match;
                    color: ink;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Text {
                    horizontal-stretch: 1;
                    text: row.label-tail;
                    color: ink;
                    font-size: 14px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            if two-line: Text {
                x: 56px;
                y: 26px;
                width: parent.width - 56px - 152px;
                height: 16px;
                text: row.location;
                color: ink-secondary;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }

            Text {
                x: parent.width - 20px - 44px - 12px - 64px;
                width: 64px;
                height: parent.height;
                text: row.kind;
                color: ink-tertiary;
                font-size: 12px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }

            if hint > 0: Text {
                x: parent.width - 20px - 44px;
                width: 44px;
                height: parent.height;
                text: "Alt+" + hint;
                color: ink-tertiary;
                font-size: 12px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }

            row-touch := TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {
                        root.open-menu(index, row-touch.mouse-x, input-height + 1px + row.y + list.content-y + row-touch.mouse-y);
                    } else if event.kind == PointerEventKind.move && !is-selected && !root.menu-open {
                        root.hover(index, row-touch.mouse-x, input-height + 1px + row.y + list.content-y + row-touch.mouse-y);
                    }
                }
                clicked => {
                    if !root.menu-open {
                        root.activate(index);
                    }
                }
            }
        }
    }

    if show-results && has-status: Text {
        x: 20px;
        y: input-height + 1px + (has-list ? list-height : 0px);
        width: parent.width - 40px;
        height: 36px;
        text: status;
        color: status-is-error ? critical : ink-secondary;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    if menu-shown: TouchArea {
        width: parent.width;
        height: parent.height;

        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.menu-hover = -1;
            }
            if event.kind == PointerEventKind.down {
                root.menu-open = false;
            }
        }
    }

    if menu-shown: Rectangle {
        x: menu-draw-x;
        y: menu-draw-y;
        width: menu-width;
        height: menu-block;
        border-radius: 8px;
        background: solid-color;
        border-width: 1px;
        border-color: divider;

        // 接住菜单空白和不可用项上的点击，避免落到后面的遮罩上把菜单关掉。
        TouchArea {
            width: 100%;
            height: 100%;
        }

        for item[index] in menu-items: Rectangle {
            x: menu-pad;
            y: menu-pad + index * menu-item-h;
            width: parent.width - menu-pad * 2;
            height: menu-item-h;
            border-radius: 6px;
            background: item.enabled && menu-hover == index ? selection-fill : transparent;

            Text {
                x: 12px;
                width: parent.width - 12px - 64px;
                height: parent.height;
                text: item.label;
                color: item.enabled ? ink : ink-tertiary;
                font-size: 14px;
                vertical-alignment: center;
                overflow: elide;
            }

            Text {
                x: parent.width - 12px - 48px;
                width: 48px;
                height: parent.height;
                text: item.hint;
                color: ink-tertiary;
                font-size: 12px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }

            TouchArea {
                width: 100%;
                height: 100%;
                enabled: item.enabled;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.move {
                        root.menu-hover = index;
                    }
                }
                clicked => {
                    if !root.menu-activate(index) {
                        root.menu-open = false;
                    }
                }
            }
        }
    }
}
