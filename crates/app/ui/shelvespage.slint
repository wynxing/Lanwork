// 面板的收纳页：左侧是分组，右侧是选中分组的条目。版式由这里决定，数据和动作在 Rust。
// 数据和回调放在 ShelvesPageData 里，面板窗口只负责把这个页面摆在标签内容区。
// 拖入拖出走原生 OLE，不用 DropArea、DragArea；这里只把行上的按下和移动交给 Rust。

import { ListView } from "std-widgets.slint";
import { Btn, Chip, Field, Ink } from "widgets.slint";

export struct ShelfGroupRow {
    name: string,
    count: int,
    // 关联待办的标题，多条用「、」连起来。没有可显示的标题时为空。
    todo: string,
    // 分组多选里这一行是否勾上。
    checked: bool,
}

export struct ShelfRefRow {
    name: string,
    icon: image,
    has-icon: bool,
    missing: bool,
    // 当前分组里这一条是否在选择中。悬浮窗不用。
    selected: bool,
}

export struct ShelfMenuRow {
    label: string,
    enabled: bool,
    danger: bool,
}

// 选中分组关联的一条待办。
export struct ShelfLinkRow {
    title: string,
    // 找得到这条待办。找不到时 title 为空。
    found: bool,
    completed: bool,
    in-trash: bool,
}

export struct ShelfTodoRow {
    title: string,
    list: string,
}

export global ShelvesPageData {
    in property <[ShelfGroupRow]> groups;
    in property <int> selected-group: -1;
    in property <[ShelfRefRow]> refs;
    in property <int> selected-ref: -1;
    // 选中条目的完整路径。
    in property <string> selected-path;
    in property <string> group-name;
    // 换了分组或需要把输入框还原时加一。
    in property <int> group-version;
    // 选中分组关联的待办，按关联的先后，包括找不到的。
    in property <[ShelfLinkRow]> links;
    // 悬浮窗里「关联待办」区域是否展开。默认收起，不记住。
    in-out property <bool> links-open: false;
    in property <bool> can-up;
    in property <bool> can-down;
    in-out property <bool> confirm-delete;
    in-out property <bool> picker-open;
    in property <[ShelfTodoRow]> choices;
    // 关键字输入框清空时加一。
    in property <int> picker-reset;
    // 列表里完整露出或部分露出的第一行和行数。
    in-out property <int> first-visible;
    in-out property <int> visible-count;

    callback select-group(int);
    callback new-group(string);
    callback rename-group(string);
    callback move-group(bool);
    callback delete-group();
    // 把选中的分组打开成独立窗口。
    callback float-group();
    callback select-ref(int);
    callback open-ref();
    callback open-ref-folder();
    callback remove-ref();
    callback open-picker();
    callback close-picker();
    callback filter-todos(string);
    callback pick-todo(int);
    // 解除对第 index 条待办的关联。
    callback unlink-todo(int);
    // 悬浮窗：勾选完成第 index 条关联待办。
    callback complete-todo(int);
    // 悬浮窗：打开面板并定位第 index 条关联待办。
    callback open-todo(int);
    callback ref-press(int, length, length);
    callback ref-move(int, length, length);
    callback ref-release();
    callback visible-changed(int, int);
    // 分组多选。点「选择」或 Ctrl/Shift 点击进入。
    in property <bool> selecting: false;
    in property <int> group-selected-count: 0;
    in property <bool> confirm-groups: false;
    // 当前分组里选中的条目数。0 时不显示底部动作。
    in property <int> ref-count: 0;
    in property <bool> confirm-refs: false;
    // 选择里至少有一条路径引用时，可以打开所在目录。
    in property <bool> can-open-folder: true;
    // 条目拖动已经越过阈值。松开时不再当作点击。
    in-out property <bool> ref-dragging: false;
    // 拖到左侧分组上时那一行。-1 表示没有放下目标。
    in property <int> drop-group: -1;
    in property <bool> menu-open: false;
    in property <length> menu-x: 0px;
    in property <length> menu-y: 0px;
    in property <[ShelfMenuRow]> menu-rows;
    // 相对窗口的几何，布局测试和分组命中测试读取。
    in-out property <length> choose-x;
    in-out property <length> choose-y;
    in-out property <length> choose-w;
    in-out property <length> choose-h;
    in-out property <length> list-y;
    in-out property <length> list-h;
    in-out property <length> bar-y;
    in-out property <length> bar-h;
    in-out property <length> new-y;
    in-out property <length> delete-x;
    in-out property <length> delete-y;
    in-out property <length> delete-w;
    in-out property <length> delete-h;
    in-out property <length> groups-x;
    in-out property <length> groups-y;
    in-out property <length> groups-w;
    in-out property <length> groups-h;
    in-out property <length> groups-content-y;
    in-out property <length> refs-x;
    in-out property <length> refs-y;
    in-out property <length> refs-w;
    in-out property <length> refs-h;
    in-out property <length> page-x;
    in-out property <length> page-y;
    in-out property <string> count-label;
    in-out property <int> geometry-refresh;

    callback set-group-selecting(bool);
    callback group-clicked(int, bool, bool);
    callback select-all-groups();
    callback clear-group-checks();
    callback ask-delete-groups();
    callback cancel-delete-groups();
    callback delete-groups();
    callback float-groups();
    callback ref-click(int, bool, bool);
    callback ref-menu(int, length, length);
    callback menu-activate(int);
    callback close-menu();
    callback select-all-refs();
    callback clear-refs();
    callback cancel-remove-refs();
}

// 关联待办的搜索框：输入关键字筛选，点击一条即关联。
component TodoPicker inherits Rectangle {
    in property <Ink> c;
    in property <bool> dark;

    background: dark ? #2b2b2b : #fafafa;

    init => {
        picker-field.focus-field();
    }

    TouchArea { }

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        HorizontalLayout {
            height: 30px;
            spacing: 8px;

            picker-field := Field {
                name: "搜索待办";
                source-text: "";
                reset: ShelvesPageData.picker-reset;
                c: root.c;
                edited(text) => {
                    ShelvesPageData.filter-todos(text);
                }
                escape => {
                    ShelvesPageData.close-picker();
                }
            }

            Btn {
                text: "取消";
                c: root.c;
                clicked => {
                    ShelvesPageData.close-picker();
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;

            if ShelvesPageData.choices.length == 0: Text {
                x: 4px;
                y: 4px;
                text: "没有待办";
                color: c.secondary;
                font-size: 14px;
            }

            ListView {
                visible: ShelvesPageData.choices.length > 0;

                for choice[index] in ShelvesPageData.choices: Rectangle {
                    height: 40px;

                    Rectangle {
                        width: parent.width;
                        border-radius: 6px;
                        background: choice-touch.has-hover ? c.hover : transparent;
                    }

                    choice-touch := TouchArea {
                        clicked => {
                            ShelvesPageData.pick-todo(index);
                        }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;

                        Text {
                            horizontal-stretch: 1;
                            text: choice.title;
                            color: c.ink;
                            font-size: 14px;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        Chip {
                            text: choice.list;
                            tone: c.secondary;
                        }
                    }
                }
            }
        }
    }
}

// 选中分组的条目列表，面板的收纳页和收纳悬浮窗共用。可见行的起止在这里算，因为列表只在选中分组时存在。
export component RefsList inherits Rectangle {
    in property <Ink> c;
    // 面板收纳页为真：单击多选，右键菜单，松开在行外不算点击。悬浮窗保持原来的单击选中。
    in property <bool> manage: false;
    // 点击条目行后让页面拿焦点，这样 Enter 和 Ctrl+Enter 才有效。
    callback focus-requested();

    property <length> row-height: 40px;
    property <int> first-row: max(0, Math.floor(-refs-list.content-y / row-height));
    property <int> row-count: Math.ceil(refs-list.visible-height / row-height) + 1;

    changed first-row => {
        ShelvesPageData.first-visible = first-row;
        ShelvesPageData.visible-changed(first-row, row-count);
    }
    changed row-count => {
        ShelvesPageData.visible-count = row-count;
        ShelvesPageData.visible-changed(first-row, row-count);
    }
    init => {
        ShelvesPageData.first-visible = first-row;
        ShelvesPageData.visible-count = row-count;
        ShelvesPageData.visible-changed(first-row, row-count);
    }

    refs-list := ListView {
        width: parent.width;
        height: parent.height;
        visible: ShelvesPageData.refs.length > 0;

        for item[index] in ShelvesPageData.refs: Rectangle {
            property <bool> is-anchor: index == ShelvesPageData.selected-ref;
            property <bool> is-selected: root.manage ? item.selected : is-anchor;

            height: row-height;

            Rectangle {
                width: parent.width;
                border-radius: 6px;
                background: is-selected ? c.selection : ref-touch.has-hover ? c.hover : transparent;
            }

            if is-anchor: Rectangle {
                x: 0px;
                y: (parent.height - 16px) / 2;
                width: 3px;
                height: 16px;
                border-radius: 1.5px;
                background: c.accent;
            }

            ref-touch := TouchArea {
                clicked => {
                    if !root.manage {
                        root.focus-requested();
                        ShelvesPageData.select-ref(index);
                    }
                }
                double-clicked => {
                    if !root.manage {
                        ShelvesPageData.select-ref(index);
                        ShelvesPageData.open-ref();
                    }
                }
                pointer-event(event) => {
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                        ShelvesPageData.ref-press(index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                    if event.kind == PointerEventKind.move && self.pressed {
                        ShelvesPageData.ref-move(index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                    if root.manage && event.button == PointerEventButton.right && event.kind == PointerEventKind.up && self.mouse-x >= 0px && self.mouse-y >= 0px && self.mouse-x < self.width && self.mouse-y < self.height {
                        root.focus-requested();
                        ShelvesPageData.ref-menu(index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                    if root.manage && event.button == PointerEventButton.left && event.kind == PointerEventKind.up && !ShelvesPageData.ref-dragging && self.mouse-x >= 0px && self.mouse-y >= 0px && self.mouse-x < self.width && self.mouse-y < self.height {
                        root.focus-requested();
                        ShelvesPageData.ref-click(index, event.modifiers.control, event.modifiers.shift);
                    }
                    if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                        ShelvesPageData.ref-release();
                    }
                }
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;

                Rectangle {
                    width: 24px;

                    if item.has-icon: Image {
                        x: 0px;
                        y: (parent.height - 24px) / 2;
                        width: 24px;
                        height: 24px;
                        source: item.icon;
                        image-fit: contain;
                    }
                }

                Text {
                    horizontal-stretch: 1;
                    text: item.name;
                    color: item.missing ? c.tertiary : c.ink;
                    font-size: 14px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if item.missing: Chip {
                    text: "路径不存在";
                    tone: c.critical;
                }
            }
        }
    }
}

export component ShelvesPage inherits Rectangle {
    in property <Ink> c;
    in property <bool> dark;
    callback escape();

    property <length> rail-width: 232px;
    property <bool> groups-empty: ShelvesPageData.groups.length == 0;
    property <bool> choose-open: ShelvesPageData.groups.length > 0 || ShelvesPageData.selecting;
    property <bool> multi: ShelvesPageData.selecting;
    property <length> menu-item-h: 32px;
    property <length> menu-pad: 4px;
    property <length> menu-width: 196px;
    property <length> menu-block: menu-pad * 2 + ShelvesPageData.menu-rows.length * menu-item-h;
    property <bool> menu-shown: ShelvesPageData.menu-open && ShelvesPageData.menu-rows.length > 0;
    property <length> menu-draw-x: min(max(8px, ShelvesPageData.menu-x), max(8px, self.width - menu-width - 8px));
    property <length> menu-draw-y: ShelvesPageData.menu-y + menu-block + 8px > self.height && ShelvesPageData.menu-y > menu-block ? max(8px, ShelvesPageData.menu-y - menu-block) : min(ShelvesPageData.menu-y, max(8px, self.height - menu-block - 8px));
    property <int> menu-hover: -1;
    property <length> geometry-tick: select-row.y + select-btn.y + select-btn.width + select-btn.height + list-host.y + list-host.height + action-bar.y + action-bar.height + new-group.y + delete-btn.x + delete-btn.y + delete-btn.width + delete-btn.height + group-list.y + group-list.height + group-list.content-y + ShelvesPageData.selected-group * 1px + ShelvesPageData.group-selected-count * 1px + ShelvesPageData.ref-count * 1px + ShelvesPageData.geometry-refresh * 1px + (ShelvesPageData.selecting ? 1px : 0px) + (ShelvesPageData.confirm-groups ? 1px : 0px) + (ShelvesPageData.confirm-refs ? 1px : 0px) + (ShelvesPageData.menu-open ? 1px : 0px);

    changed geometry-tick => {
        ShelvesPageData.choose-x = select-btn.absolute-position.x;
        ShelvesPageData.choose-y = select-btn.absolute-position.y;
        ShelvesPageData.choose-w = select-btn.width;
        ShelvesPageData.choose-h = root.choose-open ? select-btn.height : 0px;
        ShelvesPageData.list-y = list-host.absolute-position.y;
        ShelvesPageData.list-h = list-host.height;
        ShelvesPageData.bar-y = action-bar.absolute-position.y;
        ShelvesPageData.bar-h = root.multi ? action-bar.height : 0px;
        ShelvesPageData.new-y = new-group.absolute-position.y;
        ShelvesPageData.delete-x = delete-btn.absolute-position.x;
        ShelvesPageData.delete-y = delete-btn.absolute-position.y;
        ShelvesPageData.delete-w = delete-btn.width;
        ShelvesPageData.delete-h = root.multi && !ShelvesPageData.confirm-groups ? delete-btn.height : 0px;
        ShelvesPageData.groups-x = group-list.absolute-position.x;
        ShelvesPageData.groups-y = group-list.absolute-position.y;
        ShelvesPageData.groups-w = group-list.width;
        ShelvesPageData.groups-h = group-list.height;
        ShelvesPageData.groups-content-y = group-list.content-y;
        if ShelvesPageData.selected-group < 0 {
            ShelvesPageData.refs-x = 0px;
            ShelvesPageData.refs-y = 0px;
            ShelvesPageData.refs-w = 0px;
            ShelvesPageData.refs-h = 0px;
        }
        ShelvesPageData.page-x = root.absolute-position.x;
        ShelvesPageData.page-y = root.absolute-position.y;
        ShelvesPageData.count-label = "已选 " + ShelvesPageData.group-selected-count + " 个";
    }

    function dismiss-or-escape() {
        if ShelvesPageData.menu-open {
            ShelvesPageData.close-menu();
        } else if ShelvesPageData.confirm-refs {
            ShelvesPageData.cancel-remove-refs();
        } else if ShelvesPageData.confirm-groups {
            ShelvesPageData.cancel-delete-groups();
        } else if ShelvesPageData.ref-count > 0 {
            ShelvesPageData.clear-refs();
        } else if ShelvesPageData.selecting {
            ShelvesPageData.set-group-selecting(false);
        } else {
            root.escape();
        }
    }

    page-scope := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismiss-or-escape();
                return accept;
            }
            if ShelvesPageData.menu-open {
                return reject;
            }
            if event.text == Key.Delete && ShelvesPageData.ref-count > 0 {
                ShelvesPageData.remove-ref();
                return accept;
            }
            if event.modifiers.control && (event.text == "a" || event.text == "A" || event.text == "\u{0001}") {
                if ShelvesPageData.selecting {
                    ShelvesPageData.select-all-groups();
                } else {
                    ShelvesPageData.select-all-refs();
                }
                return accept;
            }
            if ShelvesPageData.ref-count > 0 && event.text == Key.Return {
                if event.modifiers.control {
                    ShelvesPageData.open-ref-folder();
                } else {
                    ShelvesPageData.open-ref();
                }
                return accept;
            }
            reject
        }

        // 左侧：分组列表和新建。多选时底部是「已选 N 个」。
        Rectangle {
            x: 0px;
            width: rail-width;
            height: root.height;

            VerticalLayout {
                padding: 8px;
                spacing: 6px;

                select-row := Rectangle {
                    visible: choose-open;
                    height: 30px;

                    select-btn := Btn {
                        text: ShelvesPageData.selecting ? "完成" : "选择";
                        c: root.c;
                        clicked => {
                            page-scope.focus();
                            ShelvesPageData.set-group-selecting(!ShelvesPageData.selecting);
                        }
                    }
                }

                list-host := Rectangle {
                    vertical-stretch: 1;

                    if groups-empty: Text {
                        x: 8px;
                        y: 6px;
                        text: "没有分组";
                        color: c.secondary;
                        font-size: 14px;
                    }

                    group-list := ListView {
                        visible: !groups-empty;

                        for group[index] in ShelvesPageData.groups: Rectangle {
                            property <bool> is-open: index == ShelvesPageData.selected-group;
                            property <bool> is-drop: index == ShelvesPageData.drop-group;
                            property <bool> is-checked: root.multi && group.checked;

                            height: group.todo != "" ? 56px : 40px;

                            Rectangle {
                                width: parent.width;
                                border-radius: 6px;
                                background: is-drop || is-checked || (!root.multi && is-open) ? c.selection : group-touch.has-hover ? c.hover : transparent;
                            }

                            if is-open && !root.multi: Rectangle {
                                x: 0px;
                                y: (parent.height - 16px) / 2;
                                width: 3px;
                                height: 16px;
                                border-radius: 1.5px;
                                background: c.accent;
                            }

                            if root.multi: Rectangle {
                                x: 8px;
                                y: (parent.height - 16px) / 2;
                                width: 16px;
                                height: 16px;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: group.checked ? c.accent : c.tertiary;
                                background: group.checked ? c.accent : transparent;

                                if group.checked: Path {
                                    width: 16px;
                                    height: 16px;
                                    viewbox-width: 16;
                                    viewbox-height: 16;
                                    fill: transparent;
                                    stroke: #ffffff;
                                    stroke-width: 1.6px;
                                    commands: "M3.5 8.2l2.8 2.8 6.2-6.4";
                                }
                            }

                            group-touch := TouchArea {
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && self.mouse-x >= 0px && self.mouse-y >= 0px && self.mouse-x < self.width && self.mouse-y < self.height {
                                        page-scope.focus();
                                        ShelvesPageData.group-clicked(index, event.modifiers.control, event.modifiers.shift);
                                    }
                                }
                            }

                            VerticalLayout {
                                padding-left: root.multi ? 30px : 12px;
                                padding-right: 8px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 2px;

                                HorizontalLayout {
                                    spacing: 6px;
                                    height: 28px;

                                    Text {
                                        horizontal-stretch: 1;
                                        text: group.name;
                                        color: c.ink;
                                        font-size: 14px;
                                        font-weight: is-open && !root.multi ? 600 : 400;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: group.count;
                                        color: c.tertiary;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                }

                                if group.todo != "": Text {
                                    text: group.todo;
                                    color: c.tertiary;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }

                action-bar := Rectangle {
                    visible: root.multi;

                    Rectangle {
                        y: 0px;
                        width: parent.width;
                        height: 1px;
                        background: c.divider;
                    }

                    VerticalLayout {
                        padding-top: 8px;
                        spacing: 6px;

                        Text {
                            height: 18px;
                            text: "已选 " + ShelvesPageData.group-selected-count + " 个";
                            color: c.secondary;
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        HorizontalLayout {
                            visible: !ShelvesPageData.confirm-groups;
                            height: 30px;
                            spacing: 4px;

                            Btn {
                                text: "全选";
                                c: root.c;
                                enabled: ShelvesPageData.group-selected-count < ShelvesPageData.groups.length;
                                clicked => {
                                    ShelvesPageData.select-all-groups();
                                }
                            }

                            Btn {
                                text: "取消全选";
                                c: root.c;
                                enabled: ShelvesPageData.group-selected-count > 0;
                                clicked => {
                                    ShelvesPageData.clear-group-checks();
                                }
                            }
                        }

                        HorizontalLayout {
                            visible: !ShelvesPageData.confirm-groups;
                            height: 30px;
                            spacing: 4px;

                            Btn {
                                text: "悬浮";
                                c: root.c;
                                enabled: ShelvesPageData.group-selected-count > 0;
                                clicked => {
                                    ShelvesPageData.float-groups();
                                }
                            }

                            delete-btn := Btn {
                                text: "删除";
                                c: root.c;
                                danger: true;
                                enabled: ShelvesPageData.group-selected-count > 0;
                                clicked => {
                                    ShelvesPageData.ask-delete-groups();
                                }
                            }
                        }

                        HorizontalLayout {
                            visible: ShelvesPageData.confirm-groups;
                            height: 30px;
                            spacing: 4px;

                            Btn {
                                text: "确认删除";
                                c: root.c;
                                danger: true;
                                enabled: ShelvesPageData.group-selected-count > 0;
                                clicked => {
                                    ShelvesPageData.delete-groups();
                                }
                            }

                            Btn {
                                text: "取消";
                                c: root.c;
                                clicked => {
                                    ShelvesPageData.cancel-delete-groups();
                                }
                            }
                        }
                    }
                }

                new-group := Field {
                    name: "新建分组";
                    c: root.c;
                    committed(text) => {
                        ShelvesPageData.new-group(text);
                        self.clear();
                    }
                    escape => {
                        root.dismiss-or-escape();
                    }
                }
            }
        }

        Rectangle {
            x: rail-width;
            width: 1px;
            height: root.height;
            background: c.divider;
        }

        // 右侧：分组的名称与动作、条目列表、选中条目的路径与动作。
        Rectangle {
            x: rail-width + 1px;
            width: root.width - rail-width - 1px;
            height: root.height;

            if ShelvesPageData.selected-group >= 0: VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    height: 30px;
                    spacing: 8px;

                    Field {
                        source-text: ShelvesPageData.group-name;
                        reset: ShelvesPageData.group-version;
                        c: root.c;
                        committed(text) => {
                            ShelvesPageData.rename-group(text);
                        }
                        escape => {
                            root.dismiss-or-escape();
                        }
                    }

                    Btn {
                        text: "上移";
                        c: root.c;
                        enabled: ShelvesPageData.can-up;
                        clicked => {
                            ShelvesPageData.move-group(true);
                        }
                    }

                    Btn {
                        text: "下移";
                        c: root.c;
                        enabled: ShelvesPageData.can-down;
                        clicked => {
                            ShelvesPageData.move-group(false);
                        }
                    }

                    Btn {
                        text: "关联待办";
                        c: root.c;
                        clicked => {
                            ShelvesPageData.open-picker();
                        }
                    }

                    Btn {
                        text: "悬浮";
                        c: root.c;
                        clicked => {
                            ShelvesPageData.float-group();
                        }
                    }

                    if !ShelvesPageData.confirm-delete: Btn {
                        text: "删除分组";
                        c: root.c;
                        danger: true;
                        clicked => {
                            ShelvesPageData.confirm-delete = true;
                        }
                    }

                    if ShelvesPageData.confirm-delete: Btn {
                        text: "确认删除";
                        c: root.c;
                        danger: true;
                        clicked => {
                            ShelvesPageData.confirm-delete = false;
                            ShelvesPageData.delete-group();
                        }
                    }

                    if ShelvesPageData.confirm-delete: Btn {
                        text: "取消";
                        c: root.c;
                        clicked => {
                            ShelvesPageData.confirm-delete = false;
                        }
                    }
                }

                if ShelvesPageData.links.length > 0: Rectangle {
                    height: min(ShelvesPageData.links.length, 3) * 30px;

                    ListView {
                        width: parent.width;
                        height: parent.height;

                        for link[index] in ShelvesPageData.links: Rectangle {
                            height: 30px;

                            HorizontalLayout {
                                spacing: 8px;

                                Chip {
                                    text: "待办";
                                    tone: c.secondary;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: link.found ? link.title : "找不到这条待办";
                                    color: link.found ? c.secondary : c.tertiary;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                Btn {
                                    text: "解除关联";
                                    c: root.c;
                                    height: 26px;
                                    clicked => {
                                        ShelvesPageData.unlink-todo(index);
                                    }
                                }
                            }
                        }
                    }
                }

                refs-host := Rectangle {
                    vertical-stretch: 1;
                    property <length> geom-tick: self.y + self.width + self.height + ShelvesPageData.geometry-refresh * 1px + ShelvesPageData.refs.length * 1px;

                    changed geom-tick => {
                        ShelvesPageData.refs-x = self.absolute-position.x;
                        ShelvesPageData.refs-y = self.absolute-position.y;
                        ShelvesPageData.refs-w = self.width;
                        ShelvesPageData.refs-h = self.height;
                    }

                    if ShelvesPageData.refs.length == 0: Text {
                        x: 4px;
                        y: 4px;
                        text: "没有条目";
                        color: c.secondary;
                        font-size: 14px;
                    }

                    RefsList {
                        width: parent.width;
                        height: parent.height;
                        c: root.c;
                        manage: true;
                        focus-requested => {
                            page-scope.focus();
                        }
                    }
                }

                if ShelvesPageData.ref-count > 0: Rectangle {
                    height: 1px;
                    background: c.divider;
                }

                if ShelvesPageData.ref-count > 0 && !ShelvesPageData.confirm-refs: HorizontalLayout {
                    height: 30px;
                    spacing: 8px;

                    Text {
                        horizontal-stretch: 1;
                        text: ShelvesPageData.ref-count > 1 ? "已选 " + ShelvesPageData.ref-count + " 条" : ShelvesPageData.selected-path;
                        color: c.secondary;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Btn {
                        text: "打开";
                        c: root.c;
                        clicked => {
                            ShelvesPageData.open-ref();
                        }
                    }

                    Btn {
                        text: "打开所在目录";
                        c: root.c;
                        enabled: ShelvesPageData.can-open-folder;
                        clicked => {
                            ShelvesPageData.open-ref-folder();
                        }
                    }

                    Btn {
                        text: "移除引用";
                        c: root.c;
                        danger: true;
                        clicked => {
                            ShelvesPageData.remove-ref();
                        }
                    }
                }

                if ShelvesPageData.confirm-refs: HorizontalLayout {
                    height: 30px;
                    spacing: 8px;

                    Text {
                        horizontal-stretch: 1;
                        text: "移除这 " + ShelvesPageData.ref-count + " 条引用";
                        color: c.secondary;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Btn {
                        text: "确认移除";
                        c: root.c;
                        danger: true;
                        clicked => {
                            ShelvesPageData.remove-ref();
                        }
                    }

                    Btn {
                        text: "取消";
                        c: root.c;
                        clicked => {
                            ShelvesPageData.cancel-remove-refs();
                        }
                    }
                }
            }

            if ShelvesPageData.picker-open: TodoPicker {
                x: 0px;
                width: parent.width;
                height: parent.height;
                c: root.c;
                dark: root.dark;
            }
        }

        if menu-shown: TouchArea {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            pointer-event(event) => {
                if event.kind == PointerEventKind.move {
                    root.menu-hover = -1;
                }
                if event.kind == PointerEventKind.down {
                    ShelvesPageData.close-menu();
                }
            }
        }

        if menu-shown: Rectangle {
            x: menu-draw-x;
            y: menu-draw-y;
            width: menu-width;
            height: menu-block;
            border-radius: 8px;
            background: root.dark ? #2b2b2b : #fafafa;
            border-width: 1px;
            border-color: c.divider;

            TouchArea { }

            for item[index] in ShelvesPageData.menu-rows: Rectangle {
                x: menu-pad;
                y: menu-pad + index * menu-item-h;
                width: parent.width - menu-pad * 2;
                height: menu-item-h;
                border-radius: 6px;
                background: item.enabled && root.menu-hover == index ? c.selection : transparent;

                Text {
                    x: 10px;
                    width: parent.width - 20px;
                    height: parent.height;
                    text: item.label;
                    color: !item.enabled ? c.tertiary : item.danger ? c.critical : c.ink;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                TouchArea {
                    enabled: item.enabled;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.move {
                            root.menu-hover = index;
                        }
                    }
                    clicked => {
                        ShelvesPageData.menu-activate(index);
                    }
                }
            }
        }
    }
}
