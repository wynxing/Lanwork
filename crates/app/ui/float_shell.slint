// 悬浮窗外壳。拖动条、钉住、关闭、来源行和贴边把手都在 `FloatChrome`。
// 工具窗口是下面的 `FloatShell`：钉住开着，来源行和叠页圆点与便签同一套。
// 便签、收纳、待办各自仍是窗口，放进同一块 `FloatChrome`，只换里面的内容。
// 这三扇不画钉住。Slint 1.18 不把基类属性导出给 Rust，所以那三扇不继承 `FloatShell`。

import { Palette } from "std-widgets.slint";
import { EdgeHandle, FloatSource, Ink } from "widgets.slint";

export struct ToolRow {
    kind: string,
    id: string,
    caption: string,
    label: string,
    progress: float,
}

export component FloatChrome inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;

    // 没记过钉住时按开。关掉之后由调用方写成 false。
    in property <bool> pinned: true;
    // 工具为真。产品悬浮窗为假：不画钉住，拖动区让到关闭按钮为止。
    in property <bool> show-pin: true;
    // 为真时拖动条下面留一行来源，即使文字是空的。收起时这一行高度是 0。
    in property <bool> show-source: false;
    in property <string> source: "";
    // 外壳底部的错误行。产品悬浮窗的错误画在内容里，把这个关掉。
    in property <bool> error-in-chrome: true;
    // 一叠的页数和当前下标。1 页时把手上不画点。
    in property <int> stack-pages: 1;
    in property <int> stack-index: 0;

    in property <bool> dark;
    in property <bool> collapsed: false;
    // ""、"left"、"right"、"top"。
    in property <string> dock-edge: "";
    // 布局测试和调试窗口用来确认内容槽里能放文字。空字符串时不显示，不是产品文案。
    in property <string> marker: "";
    // 已安装工具的名称。空字符串时不画，调试窗口保持原来的拖动条。
    in property <string> heading: "";
    // 写盘失败时的一行。空字符串不占高度。外观沿用收纳悬浮窗的错误行，规格没有另定。
    in property <string> error: "";
    in property <[ToolRow]> rows;

    callback drag-requested();
    callback strip-clicked();
    callback close-clicked();
    callback pin-clicked();
    callback row-clicked(string);

    // 公开给放进内容槽的页面，颜色仍由外壳按主题算。
    out property <Ink> c: {
        ink: dark ? #ffffff : #1b1b1b,
        secondary: dark ? #c5c5c5 : #5d5d5d,
        tertiary: dark ? #9a9a9a : #767676,
        divider: dark ? #ffffff17 : #00000014,
        hover: dark ? #ffffff0d : #00000008,
        selection: dark ? #ffffff14 : #0000000d,
        field: dark ? #ffffff0a : #ffffff80,
        accent: dark ? #60cdff : #005fb8,
        critical: dark ? #ff99a4 : #c42b1c,
    };

    out property <string> marker-text: slot-label.text;
    out property <bool> pin-drawn: pin-box.visible;
    out property <bool> source-drawn: source-row.visible;
    out property <length> source-y: source-row.absolute-position.y;
    out property <length> source-h: root.source-band;
    out property <bool> source-open: source-row.visible;
    out property <bool> close-drawn: close-box.visible;
    out property <length> drag-band: root.collapsed ? 0px : 28px;
    out property <bool> content-open: content.visible;
    out property <length> content-x: content.absolute-position.x;
    out property <length> content-y: content.absolute-position.y;
    out property <length> content-width: content.width;
    out property <length> content-height: content.height;
    out property <length> pin-x: pin-box.absolute-position.x;
    out property <length> pin-y: pin-box.absolute-position.y;
    out property <length> close-x: close-box.absolute-position.x;
    out property <length> close-y: close-box.absolute-position.y;
    out property <length> strip-x: edge-strip.absolute-position.x;
    out property <length> strip-y: edge-strip.absolute-position.y;
    out property <length> strip-width: edge-strip.width;
    out property <length> strip-height: edge-strip.height;
    out property <length> grip-width: edge-strip.grip-width;
    out property <length> grip-height: edge-strip.grip-height;
    out property <bool> strip-open: edge-strip.visible;
    out property <bool> collapsed-handle-open: collapsed-handle.visible;
    out property <length> collapsed-handle-width: collapsed-handle.width;
    out property <length> collapsed-handle-height: collapsed-handle.height;
    property <length> source-band: root.show-source && !root.collapsed ? 20px : 0px;
    property <length> error-h: root.error-in-chrome && !root.collapsed && root.error != "" ? 24px : 0px;
    out property <bool> error-drawn: error-line.visible;
    out property <string> error-text: error-line.text;

    init => {
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark => {
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    if !root.collapsed: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 28px;

        Text {
            x: 12px;
            width: parent.width - 72px;
            height: parent.height;
            visible: root.heading != "";
            text: root.heading;
            color: c.ink;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }

        TouchArea {
            x: 0px;
            y: 0px;
            width: root.show-pin ? parent.width - 56px : parent.width - 28px;
            height: parent.height;

            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.drag-requested();
                }
            }
        }
    }

    pin-box := Rectangle {
        x: parent.width - 56px;
        y: 0px;
        width: 28px;
        height: 28px;
        visible: !root.collapsed && root.show-pin;
        background: pin-touch.has-hover ? c.hover : (root.pinned ? c.selection : transparent);

        Path {
            x: 9px;
            y: 9px;
            width: 10px;
            height: 10px;
            viewbox-width: 10;
            viewbox-height: 10;
            fill: transparent;
            stroke: root.pinned ? c.accent : c.secondary;
            stroke-width: 1.2px;
            commands: "M3 2.5h4 M5 2.5v6 M2.2 5.2h5.6";
        }

        pin-touch := TouchArea {
            clicked => {
                root.pin-clicked();
            }
        }
    }

    close-box := Rectangle {
        x: parent.width - 28px;
        y: 0px;
        width: 28px;
        height: 28px;
        visible: !root.collapsed;
        background: close-touch.has-hover ? c.hover : transparent;

        Path {
            x: 9px;
            y: 9px;
            width: 10px;
            height: 10px;
            viewbox-width: 10;
            viewbox-height: 10;
            fill: transparent;
            stroke: c.secondary;
            stroke-width: 1.2px;
            commands: "M1 1l8 8 M9 1l-8 8";
        }

        close-touch := TouchArea {
            clicked => {
                root.close-clicked();
            }
        }
    }

    // 来源行在拖动条下面、内容槽外面。按下它不拖动窗口。收起时不占高度。
    source-row := FloatSource {
        x: 0px;
        y: 28px;
        width: parent.width;
        height: root.source-band;
        visible: root.source-band > 0px;
        source: root.source;
        ink: c.tertiary;
    }

    content := Rectangle {
        visible: !root.collapsed;
        x: 0px;
        y: 28px + root.source-band;
        width: parent.width;
        height: parent.height - 28px - root.source-band - root.error-h;

        @children

        slot-label := Text {
            visible: root.marker != "";
            x: 16px;
            y: 8px;
            text: root.marker;
            color: c.ink;
        }

        Flickable {
            visible: root.marker == "" && root.rows.length > 0;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            content-height: max(self.height, tool-column.preferred-height);

            tool-column := VerticalLayout {
                width: parent.width;
                padding: 12px;
                spacing: 8px;

                for row in root.rows: Rectangle {
                    height: row.kind == "button" || row.kind == "progress" ? 32px : 24px;

                    if row.kind == "text" || row.kind == "list" || row.kind == "input" || row.kind == "toggle": Text {
                        width: parent.width;
                        height: parent.height;
                        text: row.caption;
                        color: c.ink;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if row.kind == "timer": HorizontalLayout {
                        spacing: 8px;
                        height: parent.height;

                        Text {
                            text: row.label;
                            color: c.secondary;
                            font-size: 13px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: row.caption;
                            color: c.ink;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }

                    if row.kind == "button": Rectangle {
                        height: 30px;
                        width: button-label.preferred-width + 20px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: c.divider;
                        background: button-touch.has-hover ? c.hover : transparent;

                        button-label := Text {
                            x: 10px;
                            text: row.label == "" ? row.caption : row.label;
                            color: c.ink;
                            font-size: 13px;
                            vertical-alignment: center;
                            height: 100%;
                        }

                        button-touch := TouchArea {
                            clicked => {
                                root.row-clicked(row.id);
                            }
                        }
                    }

                    if row.kind == "progress": Rectangle {
                        y: (parent.height - 6px) / 2;
                        width: parent.width;
                        height: 6px;
                        border-radius: 3px;
                        background: c.selection;

                        Rectangle {
                            width: parent.width * max(0, min(1, row.progress));
                            height: parent.height;
                            border-radius: 3px;
                            background: c.accent;
                        }
                    }
                }
            }
        }
    }

    error-line := Text {
        visible: root.error-h > 0px;
        x: 12px;
        y: parent.height - root.error-h;
        width: parent.width - 24px;
        height: root.error-h;
        text: root.error;
        color: c.critical;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    collapsed-handle := EdgeHandle {
        x: 0px;
        y: 0px;
        visible: root.collapsed;
        dark: root.dark;
        along-vertical: dock-edge != "top";
        press-drags: true;
        pages: root.stack-pages;
        page-index: root.stack-index;

        pressed => {
            root.drag-requested();
        }
    }

    edge-strip := EdgeHandle {
        x: dock-edge == "right" ? parent.width - self.width : dock-edge == "top" ? (parent.width - self.width) / 2 : 0px;
        y: dock-edge == "top" ? 0px : (parent.height - self.height) / 2;
        visible: !root.collapsed && dock-edge != "";
        dark: root.dark;
        along-vertical: dock-edge != "top";

        clicked => {
            root.strip-clicked();
        }
    }
}

export component FloatShell inherits Window {
    title: "Lanwork";
    icon: @image-url("../assets/lanwork-256.png");
    no-frame: true;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;
    preferred-width: 320px;
    preferred-height: 360px;
    min-width: thin ? 1px : min(200px, limit-width);
    min-height: thin ? 1px : min(120px, limit-height);
    in property <length> limit-width: 100000px;
    in property <length> limit-height: 100000px;
    max-width: thin ? 100000px : limit-width;
    max-height: thin ? 100000px : limit-height;
    resize-border-width: thin ? 0px : 6px;
    in-out property <bool> pinned: true;
    always-on-top: root.pinned;
    in property <bool> show-pin: true;
    in property <bool> show-source: true;
    in property <string> source: "";
    // 内容区正在占用左右方向键时不翻页。这一版的工具行不接收这两个键，保持假。
    in property <bool> content-owns-arrows: false;
    in property <int> stack-pages: 1;
    in property <int> stack-index: 0;

    in property <bool> dark;
    in property <bool> acrylic;
    in property <color> solid-color: #f3f3f3;
    in property <bool> thin;
    in property <bool> collapsed: false;
    in property <string> dock-edge: "";
    in property <string> marker: "";
    in property <string> heading: "";
    in property <string> error: "";
    in property <[ToolRow]> rows;

    callback drag-requested();
    callback strip-clicked();
    callback close-clicked();
    callback pin-clicked();
    callback row-clicked(string);
    callback flip-page(int);

    out property <string> marker-text: chrome.marker-text;
    out property <bool> above-ordinary: root.always-on-top;
    out property <bool> pin-drawn: chrome.pin-drawn;
    out property <bool> source-drawn: chrome.source-drawn;
    out property <length> source-y: chrome.source-y;
    out property <length> source-h: chrome.source-h;
    out property <bool> source-open: chrome.source-open;
    out property <bool> close-drawn: chrome.close-drawn;
    out property <length> drag-band: chrome.drag-band;
    out property <bool> content-open: chrome.content-open;
    out property <length> content-x: chrome.content-x;
    out property <length> content-y: chrome.content-y;
    out property <length> content-width: chrome.content-width;
    out property <length> content-height: chrome.content-height;
    out property <length> pin-x: chrome.pin-x;
    out property <length> pin-y: chrome.pin-y;
    out property <length> close-x: chrome.close-x;
    out property <length> close-y: chrome.close-y;
    out property <length> strip-x: chrome.strip-x;
    out property <length> strip-y: chrome.strip-y;
    out property <length> strip-width: chrome.strip-width;
    out property <length> strip-height: chrome.strip-height;
    out property <length> grip-width: chrome.grip-width;
    out property <length> grip-height: chrome.grip-height;
    out property <bool> strip-open: chrome.strip-open;
    out property <bool> collapsed-handle-open: chrome.collapsed-handle-open;
    out property <length> collapsed-handle-width: chrome.collapsed-handle-width;
    out property <length> collapsed-handle-height: chrome.collapsed-handle-height;
    out property <bool> error-drawn: chrome.error-drawn;
    out property <string> error-text: chrome.error-text;

    background: collapsed ? transparent : (acrylic ? transparent : solid-color);

    chrome := FloatChrome {
        pinned: root.pinned;
        show-pin: root.show-pin;
        show-source: root.show-source;
        source: root.source;
        dark: root.dark;
        collapsed: root.collapsed;
        dock-edge: root.dock-edge;
        marker: root.marker;
        heading: root.heading;
        error: root.error;
        rows: root.rows;
        stack-pages: root.stack-pages;
        stack-index: root.stack-index;

        drag-requested => {
            root.drag-requested();
        }
        strip-clicked => {
            root.strip-clicked();
        }
        close-clicked => {
            root.close-clicked();
        }
        pin-clicked => {
            root.pin-clicked();
        }
        row-clicked(id) => {
            root.row-clicked(id);
        }

        @children
    }

    // 收起时内容槽藏起来。翻页键留在窗口上。内容区占用左右键时留给内容。
    page-keys := FocusScope {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;

        key-pressed(event) => {
            if root.stack-pages > 1 && !root.content-owns-arrows && (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                root.flip-page(event.text == Key.LeftArrow ? -1 : 1);
                return accept;
            }
            reject
        }
    }

    public function focus-stack-keys() {
        page-keys.focus();
    }
}

// 派生组件只为了确认 `@children` 能放进内容槽。测试读的是基类导出的位置。
export component FloatShellProbe inherits FloatShell {
    in property <string> child-marker: "content";

    Text {
        x: 8px;
        y: 8px;
        text: root.child-marker;
        color: #1b1b1b;
    }
}
