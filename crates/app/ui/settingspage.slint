// 面板的设置页。左边四个分类，右边是当前分类的内容。
// 版式由这里决定，数据和动作在 Rust。
// 控件只显示配置里的值；请求被拒绝或写盘失败时，Rust 重新推送原值，界面随之回到原状。
//
// 布局测试按这些坐标点（窗口里，标题 48px，其下 1px 分隔线，本页从 y=49 开始）：
// 左栏宽 132。分类从 y=8 起，步长 40，行高 36。第 i 行中心相对本页是 8+40*i+18。
// 右栏从 x=132 起，内边距左 16、上 8，行高 48，标签宽 120。
// 控件左缘相对窗口是 132+16+120=268。第 i 行中心相对本页是 8+48*i+24。
// 数据页「更换」贴在行的右边，右边距 16。按钮宽是文字宽加 20。

import { Btn, Field, Ink, Segments, ToggleSwitch } from "widgets.slint";

export struct SettingsHiddenApp {
    name: string,
}

export global SettingsPageData {
    in property <bool> launch-at-startup;
    in property <[string]> corner-titles;
    in property <int> corner;
    in property <string> hotkey;
    in property <bool> recording;
    in property <[string]> theme-titles;
    in property <int> theme;
    in property <[string]> engine-titles;
    in property <int> engine;
    in property <bool> quiet-on;
    in property <string> quiet-start;
    in property <string> quiet-end;
    in property <string> snooze-days;
    in property <int> field-reset;
    in property <string> data-dir;
    in property <string> data-dir-action: "更换";
    in property <bool> data-dir-enabled: true;
    in property <string> version-text: "0.2.0";
    in property <string> update-status;
    in property <bool> update-status-error: false;
    in property <string> update-notes;
    in property <bool> update-notes-visible: false;
    in property <string> update-button: "检查更新";
    in property <bool> update-enabled: true;

    callback set-launch-at-startup(bool);
    callback choose-corner(int);
    callback toggle-recording();
    callback choose-theme(int);
    callback choose-engine(int);
    callback set-quiet(bool);
    callback commit-quiet-start(string);
    callback commit-quiet-end(string);
    callback commit-snooze(string);
    callback choose-section(int);
    callback choose-data-dir();
    callback update-clicked();

    in property <[SettingsHiddenApp]> hidden-apps;
    callback restore-hidden(int);
}

component Row inherits Rectangle {
    in property <string> name;
    in property <Ink> c;

    height: 48px;

    Text {
        x: 0px;
        width: 120px;
        height: parent.height - 1px;
        text: root.name;
        color: c.ink;
        font-size: 14px;
        vertical-alignment: center;
        overflow: elide;
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: c.divider;
    }

    @children
}

component HotkeyBox inherits Rectangle {
    in property <string> text;
    in property <bool> recording;
    in property <Ink> c;
    callback clicked();

    width: 180px;
    height: 30px;
    border-radius: 6px;
    border-width: 1px;
    border-color: recording ? c.accent : c.divider;
    background: recording ? c.selection : touch.has-hover ? c.hover : c.field;
    accessible-role: button;
    accessible-label: text;

    Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: recording ? "录入中" : root.text;
        color: recording ? c.accent : c.ink;
        font-size: 13px;
        font-weight: recording ? 600 : 400;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component GeneralPage inherits Rectangle {
    in property <Ink> c;
    in property <bool> dark;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 8px;
        alignment: start;

        Row {
            name: "开机启动";
            c: root.c;

            ToggleSwitch {
                x: 120px;
                y: (parent.height - self.height) / 2;
                checked: SettingsPageData.launch-at-startup;
                label: "开机启动";
                c: root.c;
                on-fill: root.dark ? #000000 : #ffffff;
                toggled(value) => {
                    SettingsPageData.set-launch-at-startup(value);
                }
            }
        }

        Row {
            name: "热角";
            c: root.c;

            Segments {
                x: 120px;
                y: (parent.height - self.height) / 2;
                items: SettingsPageData.corner-titles;
                current: SettingsPageData.corner;
                c: root.c;
                chosen(index) => {
                    SettingsPageData.choose-corner(index);
                }
            }
        }

        Row {
            name: "搜索条热键";
            c: root.c;

            HotkeyBox {
                x: 120px;
                y: (parent.height - self.height) / 2;
                text: SettingsPageData.hotkey;
                recording: SettingsPageData.recording;
                c: root.c;
                clicked => {
                    SettingsPageData.toggle-recording();
                }
            }
        }

        Row {
            name: "主题";
            c: root.c;

            Segments {
                x: 120px;
                y: (parent.height - self.height) / 2;
                items: SettingsPageData.theme-titles;
                current: SettingsPageData.theme;
                c: root.c;
                chosen(index) => {
                    SettingsPageData.choose-theme(index);
                }
            }
        }

        Row {
            name: "网页搜索引擎";
            c: root.c;

            Segments {
                x: 120px;
                y: (parent.height - self.height) / 2;
                items: SettingsPageData.engine-titles;
                current: SettingsPageData.engine;
                c: root.c;
                chosen(index) => {
                    SettingsPageData.choose-engine(index);
                }
            }
        }
    }
}

component TodoPage inherits Rectangle {
    in property <Ink> c;
    in property <bool> dark;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 8px;
        alignment: start;

        Row {
            name: "安静时段";
            c: root.c;

            ToggleSwitch {
                x: 120px;
                y: (parent.height - self.height) / 2;
                checked: SettingsPageData.quiet-on;
                label: "安静时段";
                c: root.c;
                on-fill: root.dark ? #000000 : #ffffff;
                toggled(value) => {
                    SettingsPageData.set-quiet(value);
                }
            }

            if SettingsPageData.quiet-on: Field {
                x: 172px;
                y: (parent.height - self.height) / 2;
                width: 72px;
                source-text: SettingsPageData.quiet-start;
                reset: SettingsPageData.field-reset;
                name: "开始";
                c: root.c;
                committed(text) => {
                    SettingsPageData.commit-quiet-start(text);
                }
            }

            if SettingsPageData.quiet-on: Text {
                x: 248px;
                width: 16px;
                height: parent.height - 1px;
                text: "–";
                color: root.c.secondary;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if SettingsPageData.quiet-on: Field {
                x: 268px;
                y: (parent.height - self.height) / 2;
                width: 72px;
                source-text: SettingsPageData.quiet-end;
                reset: SettingsPageData.field-reset;
                name: "结束";
                c: root.c;
                committed(text) => {
                    SettingsPageData.commit-quiet-end(text);
                }
            }
        }

        Row {
            name: "稍后";
            c: root.c;

            Field {
                x: 120px;
                y: (parent.height - self.height) / 2;
                width: 72px;
                source-text: SettingsPageData.snooze-days;
                reset: SettingsPageData.field-reset;
                c: root.c;
                committed(text) => {
                    SettingsPageData.commit-snooze(text);
                }
            }
        }
    }
}

component DataPage inherits Rectangle {
    in property <Ink> c;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 8px;
        alignment: start;

        Row {
            name: "数据目录";
            c: root.c;

            // 「更换」贴在行的右边。路径在标签和按钮之间，放不下就省略。
            // 迁移进行中按钮改成进度，并且不可点。路径要等切换完成后才换。
            dir-button := Btn {
                x: parent.width - self.width;
                y: (parent.height - self.height) / 2;
                text: SettingsPageData.data-dir-action;
                enabled: SettingsPageData.data-dir-enabled;
                c: root.c;
                clicked => {
                    SettingsPageData.choose-data-dir();
                }
            }

            Text {
                x: 120px;
                width: parent.width - 120px - dir-button.width - 8px;
                height: parent.height - 1px;
                text: SettingsPageData.data-dir;
                color: root.c.secondary;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Row {
            name: "备份";
            c: root.c;
        }

        Row {
            name: "导出";
            c: root.c;
        }

        Row {
            name: "导入";
            c: root.c;
        }
    }
}

component OtherPage inherits Rectangle {
    in property <Ink> c;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 8px;
        alignment: start;

        // 关于与更新。没有说明段落。发行说明是 Release 正文。高度固定，下面的隐藏列表才不把按钮顶走。
        Rectangle {
            height: 88px + (SettingsPageData.update-notes-visible ? 120px : 0px);

            Text {
                x: 0px;
                y: 0px;
                width: 120px;
                height: 28px;
                text: "版本";
                color: root.c.ink;
                font-size: 14px;
                vertical-alignment: center;
                overflow: elide;
            }

            Text {
                x: 120px;
                y: 0px;
                width: parent.width - 120px;
                height: 28px;
                text: SettingsPageData.version-text;
                color: root.c.ink;
                font-size: 14px;
                vertical-alignment: center;
                overflow: elide;
            }

            Text {
                x: 120px;
                y: 28px;
                width: parent.width - 120px;
                height: 20px;
                text: SettingsPageData.update-status;
                color: SettingsPageData.update-status-error ? root.c.critical : root.c.secondary;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }

            if SettingsPageData.update-notes-visible: Text {
                x: 0px;
                y: 52px;
                width: parent.width;
                height: 112px;
                text: SettingsPageData.update-notes;
                color: root.c.ink;
                font-size: 13px;
                wrap: word-wrap;
                overflow: elide;
            }

            Btn {
                x: 120px;
                y: 52px + (SettingsPageData.update-notes-visible ? 120px : 0px);
                text: SettingsPageData.update-button;
                enabled: SettingsPageData.update-enabled;
                c: root.c;
                clicked => {
                    SettingsPageData.update-clicked();
                }
            }
        }

        Text {
            height: 40px;
            text: "隐藏的应用";
            color: root.c.ink;
            font-size: 14px;
            vertical-alignment: center;
        }

        if SettingsPageData.hidden-apps.length == 0: Text {
            height: 36px;
            text: "没有隐藏的应用";
            color: root.c.secondary;
            font-size: 13px;
            vertical-alignment: center;
        }

        if SettingsPageData.hidden-apps.length > 0: hidden-list := Flickable {
            vertical-stretch: 1;
            min-height: 44px;
            content-width: self.width;
            content-height: max(self.height, SettingsPageData.hidden-apps.length * 44px);

            for app[index] in SettingsPageData.hidden-apps: Rectangle {
                y: index * 44px;
                width: hidden-list.width;
                height: 44px;

                Text {
                    width: parent.width - 80px;
                    height: parent.height;
                    text: app.name;
                    color: root.c.ink;
                    font-size: 14px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Btn {
                    x: parent.width - self.width;
                    y: (parent.height - self.height) / 2;
                    text: "恢复";
                    c: root.c;
                    clicked => {
                        SettingsPageData.restore-hidden(index);
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    width: parent.width;
                    background: root.c.divider;
                }
            }
        }
    }
}

component NavItem inherits Rectangle {
    in property <string> name;
    in property <bool> selected;
    in property <Ink> c;
    callback clicked();

    x: 8px;
    width: 116px;
    height: 36px;
    border-radius: 6px;
    background: selected ? c.selection : touch.has-hover ? c.hover : transparent;

    Text {
        x: 12px;
        width: parent.width - 20px;
        height: 100%;
        text: root.name;
        color: selected ? c.ink : c.secondary;
        font-size: 13px;
        font-weight: selected ? 600 : 400;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.clicked();
        }
    }
}

export component SettingsPage inherits Rectangle {
    in property <Ink> c;
    in property <bool> dark;
    property <int> section: 0;

    Rectangle {
        x: 0px;
        y: 0px;
        width: 132px;
        height: 100%;

        Rectangle {
            x: 131px;
            width: 1px;
            height: 100%;
            background: root.c.divider;
        }

        NavItem {
            y: 8px;
            name: "常规";
            selected: root.section == 0;
            c: root.c;
            clicked => {
                if (root.section != 0) {
                    root.section = 0;
                    SettingsPageData.choose-section(0);
                }
            }
        }

        NavItem {
            y: 48px;
            name: "待办";
            selected: root.section == 1;
            c: root.c;
            clicked => {
                if (root.section != 1) {
                    root.section = 1;
                    SettingsPageData.choose-section(1);
                }
            }
        }

        NavItem {
            y: 88px;
            name: "数据";
            selected: root.section == 2;
            c: root.c;
            clicked => {
                if (root.section != 2) {
                    root.section = 2;
                    SettingsPageData.choose-section(2);
                }
            }
        }

        NavItem {
            y: 128px;
            name: "其他";
            selected: root.section == 3;
            c: root.c;
            clicked => {
                if (root.section != 3) {
                    root.section = 3;
                    SettingsPageData.choose-section(3);
                }
            }
        }
    }

    if root.section == 0: GeneralPage {
        x: 132px;
        width: parent.width - 132px;
        height: 100%;
        c: root.c;
        dark: root.dark;
    }

    if root.section == 1: TodoPage {
        x: 132px;
        width: parent.width - 132px;
        height: 100%;
        c: root.c;
        dark: root.dark;
    }

    if root.section == 2: DataPage {
        x: 132px;
        width: parent.width - 132px;
        height: 100%;
        c: root.c;
    }

    if root.section == 3: OtherPage {
        x: 132px;
        width: parent.width - 132px;
        height: 100%;
        c: root.c;
    }
}
