// 待办悬浮窗的列表。拖动条、关闭、来源行和贴边把手在共用的 FloatChrome 里。
// 没有钉住按钮，窗口始终在最上层。可以勾选完成和取消完成。不能新建，也不能改标题。
// 来源行默认文字是「待办」。

import { ListView } from "std-widgets.slint";
import { FloatChrome } from "float_shell.slint";
import { Check, Ink } from "widgets.slint";

export struct TodoFloatRow {
    title: string,
    completed: bool,
    overdue: bool,
}

export component TodoFloat inherits Window {
    title: "Lanwork";
    icon: @image-url("../assets/lanwork-256.png");
    no-frame: true;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;
    preferred-width: 320px;
    preferred-height: 360px;
    min-width: thin ? 1px : min(200px, limit-width);
    min-height: thin ? 1px : min(120px, limit-height);
    in property <length> limit-width: 100000px;
    in property <length> limit-height: 100000px;
    max-width: thin ? 100000px : limit-width;
    max-height: thin ? 100000px : limit-height;
    resize-border-width: thin ? 0px : 6px;
    always-on-top: true;

    in property <bool> dark;
    in property <bool> acrylic;
    in property <color> solid-color: #f3f3f3;
    in property <string> error;
    in property <bool> thin;
    in property <bool> collapsed;
    // ""、"left"、"right"、"top"。
    in property <string> dock-edge;
    in property <int> stack-pages: 1;
    in property <int> stack-index: 0;
    in property <[TodoFloatRow]> rows;
    in property <string> source: "待办";

    callback close-clicked();
    callback drag-requested();
    callback strip-clicked();
    callback flip-page(int);
    callback toggle-row(int);

    property <Ink> c: chrome.c;
    // 错误画在列表上面，字号沿用原来的 12px。外壳底部那一行留给工具窗口。
    property <length> row-error: root.error != "" ? 24px : 0px;
    out property <length> content-y: chrome.content-y;
    out property <length> source-y: chrome.source-y;
    out property <length> source-h: chrome.source-h;
    out property <bool> source-open: chrome.source-open;
    out property <length> row-h: 36px;
    out property <bool> shows-empty: !root.collapsed && rows.length == 0;
    out property <length> close-x: chrome.close-x;
    out property <length> close-y: chrome.close-y;
    out property <length> strip-x: chrome.strip-x;
    out property <length> strip-y: chrome.strip-y;
    out property <length> strip-width: chrome.strip-width;
    out property <length> strip-height: chrome.strip-height;
    out property <length> grip-width: chrome.grip-width;
    out property <length> grip-height: chrome.grip-height;

    background: collapsed ? transparent : (acrylic ? transparent : solid-color);

    init => {
        float-scope.focus();
    }

    public function focus-float() {
        float-scope.focus();
    }

    chrome := FloatChrome {
        dark: root.dark;
        collapsed: root.collapsed;
        dock-edge: root.dock-edge;
        source: root.source;
        stack-pages: root.stack-pages;
        stack-index: root.stack-index;
        show-pin: false;
        show-source: true;
        error-in-chrome: false;

        close-clicked => {
            root.close-clicked();
        }
        drag-requested => {
            root.drag-requested();
        }
        strip-clicked => {
            root.strip-clicked();
        }

        if root.error != "": Text {
            x: 12px;
            y: 0px;
            width: parent.width - 24px;
            height: root.row-error;
            text: root.error;
            color: root.c.critical;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }

        if rows.length == 0: Text {
            x: 16px;
            y: root.row-error + 12px;
            text: "没有待办";
            color: root.c.secondary;
            font-size: 14px;
        }

        list := ListView {
            x: 0px;
            y: root.row-error;
            width: parent.width;
            // `@children` 的 parent.height 是整窗，不是内容槽。
            height: root.height - 28px - 20px - root.row-error;

            for row[index] in rows: Rectangle {
                height: root.row-h;

                Check {
                    x: 4px;
                    y: (parent.height - self.height) / 2;
                    c: root.c;
                    checked: row.completed;
                    toggled => {
                        root.toggle-row(index);
                    }
                }

                Text {
                    x: 36px;
                    y: 0px;
                    width: parent.width - 44px;
                    height: parent.height;
                    text: row.title;
                    color: row.overdue ? root.c.critical : row.completed ? root.c.tertiary : root.c.ink;
                    font-size: 14px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    // 收起时内容槽藏起来。翻页键留在窗口上。勾选框不拿键盘焦点。
    float-scope := FocusScope {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;

        key-pressed(event) => {
            if root.stack-pages > 1 && (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                root.flip-page(event.text == Key.LeftArrow ? -1 : 1);
                return accept;
            }
            reject
        }
    }
}
