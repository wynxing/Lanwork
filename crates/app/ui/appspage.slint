// 面板的应用页。工具卡片排成一列，「导入+」在最后。
// 版式沿用已审过的预览和面板：浅底、细描边、没有色块按钮。数据和动作在 Rust。
// 开关只显示 enabled，点击时请求相反的值，不自己翻转。
//
// 几何写进 AppsPageData，布局测试读取。坐标是面板窗口里的逻辑像素。

import { Btn, Ink, ToggleSwitch } from "widgets.slint";

export struct AppToolCard {
    tool-id: string,
    name: string,
    detail: string,
    mark: string,
    has-icon: bool,
    icon: image,
    enabled: bool,
}

export global AppsPageData {
    in property <[AppToolCard]> tools;
    in-out property <bool> menu-open: false;
    in-out property <int> menu-index: -1;
    in property <[string]> menu-items;
    in-out property <length> menu-anchor-x: 0px;
    in-out property <length> menu-anchor-y: 0px;
    in-out property <length> menu-anchor-w: 0px;
    in-out property <length> menu-anchor-h: 0px;

    // 布局测试读取的窗口坐标。
    in-out property <bool> import-shown: false;
    in-out property <length> import-x: 0px;
    in-out property <length> import-y: 0px;
    in-out property <length> import-w: 0px;
    in-out property <length> import-h: 0px;
    in-out property <length> card-x: 0px;
    in-out property <length> card-y: 0px;
    in-out property <length> card-w: 0px;
    in-out property <length> card-h: 0px;
    in-out property <string> card-name: "";
    in-out property <string> card-detail: "";
    in-out property <string> card-mark: "";
    in-out property <bool> mark-shown: false;
    in-out property <bool> icon-shown: false;
    in-out property <length> open-x: 0px;
    in-out property <length> open-y: 0px;
    in-out property <length> open-w: 0px;
    in-out property <length> open-h: 0px;
    in-out property <bool> open-enabled: false;
    in-out property <length> switch-x: 0px;
    in-out property <length> switch-y: 0px;
    in-out property <length> switch-w: 0px;
    in-out property <length> switch-h: 0px;
    in-out property <bool> switch-checked: false;
    in-out property <length> more-x: 0px;
    in-out property <length> more-y: 0px;
    in-out property <length> more-w: 0px;
    in-out property <length> more-h: 0px;
    in-out property <bool> menu-shown: false;
    in-out property <length> menu-x: 0px;
    in-out property <length> menu-y: 0px;
    in-out property <length> menu-w: 0px;
    in-out property <length> menu-h: 0px;
    in-out property <string> menu-first: "";
    // 布局测试在画出一帧后加一，让几何再写一次。界面本身不使用。
    in-out property <int> layout-tick: 0;

    // 导入确认、查看权限、卸载、填写密钥。kind 是 "perm"、"uninstall" 或 "secret"。
    in property <bool> dialog-open: false;
    in property <string> dialog-kind: "";
    in property <bool> dialog-update: false;
    in property <bool> dialog-confirm: false;
    in property <string> dialog-name: "";
    in property <string> dialog-detail: "";
    in property <[string]> dialog-lines;
    in property <string> dialog-note: "";
    in-out property <bool> dialog-shown: false;
    in-out property <string> dialog-kicker: "";
    in-out property <string> dialog-note-text: "";
    in-out property <bool> confirm-shown: false;
    in-out property <string> confirm-label: "";
    in-out property <bool> danger-shown: false;
    in-out property <string> dialog-line: "";
    in-out property <bool> secret-shown: false;
    in-out property <bool> secret-masked: false;
    in-out property <string> secret-label: "";
    in-out property <bool> save-shown: false;
    in-out property <bool> clear-shown: false;
    in-out property <length> save-x: 0px;
    in-out property <length> save-y: 0px;
    in-out property <length> save-w: 0px;
    in-out property <length> save-h: 0px;
    in-out property <length> clear-x: 0px;
    in-out property <length> clear-y: 0px;
    in-out property <length> clear-w: 0px;
    in-out property <length> clear-h: 0px;
    // 打开和关闭各加一。输入框据此把 text 置空，避免 for 复用上次的原文。
    in-out property <int> secret-generation: 0;
    in-out property <string> secret-value: "";
    in-out property <length> field-x: 0px;
    in-out property <length> field-y: 0px;
    in-out property <length> field-w: 0px;
    in-out property <length> field-h: 0px;

    callback open-float(string);
    callback toggle-enabled(string, bool);
    callback open-menu(int);
    callback close-menu();
    callback menu-chosen(int);
    callback import-clicked();
    callback cancel-dialog();
    callback confirm-dialog();
    callback secret-edited(int, string);
    callback save-secrets();
    callback clear-secrets();
}

// 与单行 Field 同一套描边和高度。只给填写密钥用，掩码输入，不回显。
// generation 变化时把 text 置空。关掉对话框时这一层会被销毁，避免 for 复用上次的原文。
component SecretInput inherits Rectangle {
    in property <Ink> c;
    in property <int> generation: 0;
    callback edited(string);
    out property <bool> masked: input.input-type == InputType.password;
    out property <string> value: input.text;

    height: 30px;
    border-radius: 6px;
    background: c.field;
    border-width: 1px;
    border-color: input.has-focus ? c.accent : c.divider;
    clip: true;

    function blank() {
        input.text = "";
    }

    init => {
        root.blank();
    }
    changed generation => {
        root.blank();
    }

    input := TextInput {
        x: 10px;
        width: parent.width - 20px - self.text-cursor-width;
        height: 100%;
        single-line: true;
        input-type: InputType.password;
        font-size: 13px;
        color: c.ink;
        vertical-alignment: center;
        selection-background-color: c.accent.with-alpha(0.35);
        selection-foreground-color: c.ink;

        edited => {
            root.edited(self.text);
        }
    }
}

component ToolCard inherits Rectangle {
    in property <AppToolCard> card;
    in property <int> index;
    in property <bool> report: false;
    in property <Ink> c;
    in property <bool> dark;

    // 预览是实心白卡片。暗色用和收纳菜单同一块底，避免亮色卡片贴在暗色面板上。
    property <color> fill: dark ? #2b2b2b : #ffffff;

    height: 72px;
    border-radius: 8px;
    border-width: 1px;
    border-color: c.divider;
    background: fill;

    icon-box := Rectangle {
        x: 12px;
        y: (parent.height - 32px) / 2;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        background: c.selection;
        clip: true;

        if card.has-icon: Image {
            width: 100%;
            height: 100%;
            source: card.icon;
            image-fit: contain;
        }

        if !card.has-icon: Text {
            width: 100%;
            height: 100%;
            text: card.mark;
            color: c.ink;
            font-size: 14px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    more := Rectangle {
        x: parent.width - 12px - 30px;
        y: (parent.height - 30px) / 2;
        width: 30px;
        height: 30px;
        border-radius: 6px;
        border-width: 1px;
        border-color: c.divider;
        background: more-touch.has-hover ? c.hover : transparent;

        Rectangle {
            x: (parent.width - 12px) / 2;
            y: (parent.height - 2px) / 2;
            width: 2px;
            height: 2px;
            border-radius: 1px;
            background: c.secondary;
        }

        Rectangle {
            x: (parent.width - 2px) / 2;
            y: (parent.height - 2px) / 2;
            width: 2px;
            height: 2px;
            border-radius: 1px;
            background: c.secondary;
        }

        Rectangle {
            x: (parent.width - 12px) / 2 + 10px;
            y: (parent.height - 2px) / 2;
            width: 2px;
            height: 2px;
            border-radius: 1px;
            background: c.secondary;
        }

        more-touch := TouchArea {
            clicked => {
                AppsPageData.menu-anchor-x = more.absolute-position.x;
                AppsPageData.menu-anchor-y = more.absolute-position.y;
                AppsPageData.menu-anchor-w = more.width;
                AppsPageData.menu-anchor-h = more.height;
                if AppsPageData.menu-open && AppsPageData.menu-index == root.index {
                    AppsPageData.close-menu();
                } else {
                    AppsPageData.open-menu(root.index);
                }
            }
        }
    }

    sw := ToggleSwitch {
        x: more.x - 8px - self.width;
        y: (parent.height - self.height) / 2;
        checked: card.enabled;
        c: root.c;
        label: card.name;
        toggled(next) => {
            AppsPageData.toggle-enabled(card.tool-id, next);
        }
    }

    open-btn := Btn {
        x: sw.x - 8px - self.width;
        y: (parent.height - self.height) / 2;
        text: "悬浮窗";
        enabled: card.enabled;
        c: root.c;
        clicked => {
            AppsPageData.open-float(card.tool-id);
        }
    }

    Text {
        x: 56px;
        y: 16px;
        width: max(0px, open-btn.x - 16px - 56px);
        text: card.name;
        color: c.ink;
        font-size: 14px;
        vertical-alignment: center;
        height: 20px;
        overflow: elide;
    }

    Text {
        x: 56px;
        y: 38px;
        width: max(0px, open-btn.x - 16px - 56px);
        text: card.detail;
        color: c.secondary;
        font-size: 12px;
        vertical-alignment: center;
        height: 18px;
        overflow: elide;
    }

    property <int> tick: AppsPageData.layout-tick;
    changed tick => { root.publish(); }
    changed x => { root.publish(); }
    changed y => { root.publish(); }
    changed width => { root.publish(); }

    function publish() {
        if !root.report {
            return;
        }
        AppsPageData.card-x = root.absolute-position.x;
        AppsPageData.card-y = root.absolute-position.y;
        AppsPageData.card-w = root.width;
        AppsPageData.card-h = root.height;
        AppsPageData.card-name = card.name;
        AppsPageData.card-detail = card.detail;
        AppsPageData.card-mark = card.mark;
        AppsPageData.mark-shown = !card.has-icon && card.mark != "";
        AppsPageData.icon-shown = card.has-icon;
        AppsPageData.open-x = open-btn.absolute-position.x;
        AppsPageData.open-y = open-btn.absolute-position.y;
        AppsPageData.open-w = open-btn.width;
        AppsPageData.open-h = open-btn.height;
        AppsPageData.open-enabled = card.enabled;
        AppsPageData.switch-x = sw.absolute-position.x;
        AppsPageData.switch-y = sw.absolute-position.y;
        AppsPageData.switch-w = sw.width;
        AppsPageData.switch-h = sw.height;
        AppsPageData.switch-checked = card.enabled;
        AppsPageData.more-x = more.absolute-position.x;
        AppsPageData.more-y = more.absolute-position.y;
        AppsPageData.more-w = more.width;
        AppsPageData.more-h = more.height;
    }
}

component ImportCard inherits Rectangle {
    in property <Ink> c;
    in property <bool> dark;

    property <color> fill: dark ? #2b2b2b : #ffffff;

    height: 72px;
    border-radius: 8px;
    border-width: 1px;
    border-color: c.divider;
    background: fill;

    Rectangle {
        x: 12px;
        y: (parent.height - 32px) / 2;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        background: c.selection;

        Path {
            x: 9px;
            y: 9px;
            width: 14px;
            height: 14px;
            viewbox-width: 14;
            viewbox-height: 14;
            fill: transparent;
            stroke: c.secondary;
            stroke-width: 1.4px;
            commands: "M7 2v10 M2 7h10";
        }
    }

    Text {
        x: 56px;
        width: parent.width - 68px;
        height: parent.height;
        text: "导入+";
        color: c.ink;
        font-size: 14px;
        vertical-alignment: center;
        overflow: elide;
    }

    TouchArea {
        clicked => {
            AppsPageData.import-clicked();
        }
    }

    property <int> tick: AppsPageData.layout-tick;
    changed tick => { root.publish(); }
    changed x => { root.publish(); }
    changed y => { root.publish(); }
    changed width => { root.publish(); }

    function publish() {
        AppsPageData.import-x = root.absolute-position.x;
        AppsPageData.import-y = root.absolute-position.y;
        AppsPageData.import-w = root.width;
        AppsPageData.import-h = root.height;
    }
}

export component AppsPage inherits Rectangle {
    in property <Ink> c;
    in property <bool> dark;

    property <length> menu-item-h: 32px;
    property <length> menu-pad: 4px;
    property <length> menu-width: 168px;
    property <length> menu-block: menu-pad * 2 + AppsPageData.menu-items.length * menu-item-h;
    property <bool> menu-drawn: AppsPageData.menu-open && AppsPageData.menu-items.length > 0;
    // 锚点是「⋯」在窗口里的位置。菜单右缘对齐按钮，优先画在按钮下面。
    property <length> menu-local-x: AppsPageData.menu-anchor-x - self.absolute-position.x;
    property <length> menu-local-y: AppsPageData.menu-anchor-y - self.absolute-position.y;
    property <length> menu-draw-x: min(max(8px, menu-local-x + AppsPageData.menu-anchor-w - menu-width), max(8px, self.width - menu-width - 8px));
    property <length> menu-below: menu-local-y + AppsPageData.menu-anchor-h + 4px;
    property <length> menu-draw-y: menu-below + menu-block + 8px > self.height && menu-local-y > menu-block ? max(8px, menu-local-y - 4px - menu-block) : min(menu-below, max(8px, self.height - menu-block - 8px));

    // preferred-height 把列表里的卡片建出来，否则卡片的坐标不会写进 AppsPageData。
    property <bool> perm-open: AppsPageData.dialog-open && AppsPageData.dialog-kind == "perm";
    property <bool> uninstall-open: AppsPageData.dialog-open && AppsPageData.dialog-kind == "uninstall";
    property <bool> secret-open: AppsPageData.dialog-open && AppsPageData.dialog-kind == "secret";
    property <length> geom: column.preferred-height + import-card.absolute-position.y + import-card.width + root.width + root.height + (menu-drawn ? menu-box.absolute-position.x + menu-box.absolute-position.y + menu-block : 0px) + AppsPageData.tools.length * 1px + AppsPageData.layout-tick * 1px + (perm-open ? perm-box.height : 0px) + (uninstall-open ? uninstall-box.height : 0px) + (secret-open ? secret-box.height : 0px);

    changed geom => {
        AppsPageData.import-shown = true;
        AppsPageData.menu-shown = menu-drawn;
        AppsPageData.menu-x = menu-box.absolute-position.x;
        AppsPageData.menu-y = menu-box.absolute-position.y;
        AppsPageData.menu-w = menu-drawn ? menu-width : 0px;
        AppsPageData.menu-h = menu-drawn ? menu-block : 0px;
        AppsPageData.menu-first = AppsPageData.menu-items.length > 0 ? AppsPageData.menu-items[0] : "";
        AppsPageData.dialog-shown = perm-open || uninstall-open || secret-open;
        AppsPageData.dialog-kicker = perm-kicker.visible ? perm-kicker.text : "";
        AppsPageData.dialog-note-text = perm-note.visible ? perm-note.text : "";
        AppsPageData.confirm-shown = perm-open && confirm-btn.visible;
        AppsPageData.confirm-label = perm-open && confirm-btn.visible ? "确认" : "";
        AppsPageData.danger-shown = uninstall-open;
        AppsPageData.dialog-line = AppsPageData.dialog-lines.length > 0 ? AppsPageData.dialog-lines[0] : "";
        AppsPageData.secret-shown = secret-open;
        AppsPageData.secret-label = secret-open && AppsPageData.dialog-lines.length > 0 ? AppsPageData.dialog-lines[0] : "";
        AppsPageData.save-shown = secret-open && save-btn.visible;
        AppsPageData.clear-shown = secret-open && clear-btn.visible;
        AppsPageData.save-x = save-btn.absolute-position.x;
        AppsPageData.save-y = save-btn.absolute-position.y;
        AppsPageData.save-w = save-btn.width;
        AppsPageData.save-h = save-btn.height;
        AppsPageData.clear-x = clear-btn.absolute-position.x;
        AppsPageData.clear-y = clear-btn.absolute-position.y;
        AppsPageData.clear-w = clear-btn.width;
        AppsPageData.clear-h = clear-btn.height;
        AppsPageData.secret-masked = secret-open && secret-box.field-masked;
        if !secret-open {
            AppsPageData.secret-value = "";
        }
    }

    changed secret-open => {
        AppsPageData.secret-generation = AppsPageData.secret-generation + 1;
    }

    flick := Flickable {
        x: 0px;
        y: 12px;
        width: parent.width;
        height: parent.height - self.y;
        content-height: max(self.height, column.preferred-height);

        column := VerticalLayout {
            width: parent.width;
            padding-left: 16px;
            padding-right: 16px;
            spacing: 8px;

            for card[index] in AppsPageData.tools: ToolCard {
                card: card;
                index: index;
                report: index == 0;
                c: root.c;
                dark: root.dark;
            }

            import-card := ImportCard {
                c: root.c;
                dark: root.dark;
            }
        }
    }

    TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        visible: menu-drawn;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                AppsPageData.close-menu();
            }
        }
    }

    menu-box := Rectangle {
        x: menu-draw-x;
        y: menu-draw-y;
        width: menu-width;
        height: menu-block;
        visible: menu-drawn;
        border-radius: 8px;
        border-width: 1px;
        border-color: c.divider;
        background: dark ? #2b2b2b : #fafafa;

        TouchArea { }

        for item[index] in AppsPageData.menu-items: Rectangle {
            x: menu-pad;
            y: menu-pad + index * menu-item-h;
            width: parent.width - menu-pad * 2;
            height: menu-item-h;
            border-radius: 6px;
            background: row-touch.has-hover ? c.selection : transparent;

            Text {
                x: 12px;
                width: parent.width - 24px;
                height: parent.height;
                text: item;
                color: c.ink;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }

            row-touch := TouchArea {
                clicked => {
                    AppsPageData.menu-chosen(index);
                }
            }
        }
    }

    if AppsPageData.dialog-open: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #1b1b1b0a;

        TouchArea {
            clicked => {
                AppsPageData.cancel-dialog();
            }
        }
    }

    perm-box := Rectangle {
        visible: perm-open;
        property <length> box-w: 420px;
        property <length> line-h: 26px;
        property <length> lines-h: max(line-h, AppsPageData.dialog-lines.length * line-h);
        property <length> note-h: AppsPageData.dialog-note == "" ? 0px : 28px;
        property <length> kicker-h: AppsPageData.dialog-update ? 20px : 0px;
        property <length> box-h: min(404px, 20px + kicker-h + 22px + 22px + 12px + lines-h + 16px + note-h + 46px);

        x: (parent.width - box-w) / 2;
        y: max(8px, (parent.height - box-h) / 2);
        width: box-w;
        height: box-h;
        border-radius: 12px;
        border-width: 1px;
        border-color: c.divider;
        background: dark ? #2b2b2b : #fafafa;

        TouchArea { }

        perm-kicker := Text {
            x: 20px;
            y: 18px;
            visible: AppsPageData.dialog-update;
            text: "更新";
            color: c.tertiary;
            font-size: 12px;
        }

        Text {
            x: 20px;
            y: 18px + kicker-h;
            width: parent.width - 40px;
            text: AppsPageData.dialog-name;
            color: c.ink;
            font-size: 16px;
            font-weight: 600;
            overflow: elide;
        }

        Text {
            x: 20px;
            y: 18px + kicker-h + 26px;
            width: parent.width - 40px;
            text: AppsPageData.dialog-detail;
            color: c.secondary;
            font-size: 13px;
            overflow: elide;
        }

        Flickable {
            x: 20px;
            y: 18px + kicker-h + 52px;
            width: parent.width - 40px;
            height: min(lines-h, parent.height - self.y - note-h - 58px);
            content-height: lines-h;

            for line[index] in AppsPageData.dialog-lines: Text {
                y: index * 26px;
                width: parent.width;
                height: 26px;
                text: line;
                color: c.ink;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Rectangle {
            x: 20px;
            y: parent.height - note-h - 46px;
            width: parent.width - 40px;
            height: 1px;
            background: c.divider;
        }

        perm-note := Text {
            x: 20px;
            y: parent.height - note-h - 34px;
            width: parent.width - 40px;
            height: note-h;
            visible: AppsPageData.dialog-note != "";
            text: AppsPageData.dialog-note;
            color: c.secondary;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }

        HorizontalLayout {
            x: 20px;
            y: parent.height - 42px;
            width: parent.width - 40px;
            height: 30px;
            spacing: 8px;
            alignment: end;

            Btn {
                text: "取消";
                c: root.c;
                clicked => {
                    AppsPageData.cancel-dialog();
                }
            }

            confirm-btn := Btn {
                visible: AppsPageData.dialog-confirm;
                text: "确认";
                c: root.c;
                clicked => {
                    AppsPageData.confirm-dialog();
                }
            }
        }
    }

    uninstall-box := Rectangle {
        visible: uninstall-open;
        property <length> box-w: 360px;
        property <length> box-h: 148px;

        x: (parent.width - box-w) / 2;
        y: max(8px, (parent.height - box-h) / 2);
        width: box-w;
        height: box-h;
        border-radius: 12px;
        border-width: 1px;
        border-color: c.divider;
        background: dark ? #2b2b2b : #fafafa;

        TouchArea { }

        Text {
            x: 20px;
            y: 20px;
            width: parent.width - 40px;
            text: AppsPageData.dialog-name;
            color: c.ink;
            font-size: 16px;
            font-weight: 600;
            overflow: elide;
        }

        Text {
            x: 20px;
            y: 52px;
            width: parent.width - 40px;
            text: "会删除这个工具的存储和密钥。";
            color: c.secondary;
            font-size: 13px;
            overflow: elide;
        }

        HorizontalLayout {
            x: 20px;
            y: 96px;
            width: parent.width - 40px;
            height: 30px;
            spacing: 8px;
            alignment: end;

            Btn {
                text: "取消";
                c: root.c;
                clicked => {
                    AppsPageData.cancel-dialog();
                }
            }

            danger-btn := Btn {
                text: "卸载";
                danger: true;
                c: root.c;
                clicked => {
                    AppsPageData.confirm-dialog();
                }
            }
        }
    }

    secret-box := Rectangle {
        visible: secret-open;
        property <length> box-w: 420px;
        property <bool> field-masked: false;
        property <length> row-h: 40px;
        property <length> rows-h: max(row-h, AppsPageData.dialog-lines.length * row-h);
        property <length> rows-view: min(rows-h, 240px);
        property <length> box-h: 52px + rows-view + 62px;

        x: (parent.width - box-w) / 2;
        y: max(8px, (parent.height - box-h) / 2);
        width: box-w;
        height: box-h;
        border-radius: 12px;
        border-width: 1px;
        border-color: c.divider;
        background: dark ? #2b2b2b : #fafafa;

        TouchArea { }

        Text {
            x: 20px;
            y: 20px;
            width: parent.width - 40px;
            text: AppsPageData.dialog-name;
            color: c.ink;
            font-size: 16px;
            font-weight: 600;
            overflow: elide;
        }

        // 关掉时销毁这些输入。visible 只是藏起来，for 会按行数复用，原文会留到下一次。
        if secret-open: Flickable {
            x: 20px;
            y: 52px;
            width: parent.width - 40px;
            height: rows-view;
            content-height: rows-h;

            for line[index] in AppsPageData.dialog-lines: Rectangle {
                y: index * row-h;
                width: parent.width;
                height: row-h;
                property <int> tick: AppsPageData.layout-tick;
                property <string> live: secret-field.value;

                HorizontalLayout {
                    y: 5px;
                    width: parent.width;
                    height: 30px;
                    spacing: 12px;

                    Text {
                        width: 112px;
                        height: 30px;
                        text: line;
                        color: c.ink;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    secret-field := SecretInput {
                        horizontal-stretch: 1;
                        c: root.c;
                        generation: AppsPageData.secret-generation;
                        edited(text) => {
                            AppsPageData.secret-edited(index, text);
                        }
                    }
                }

                init => {
                    if index == 0 {
                        secret-box.field-masked = secret-field.masked;
                        AppsPageData.secret-value = "";
                    }
                }

                changed tick => {
                    if index == 0 {
                        AppsPageData.field-x = secret-field.absolute-position.x;
                        AppsPageData.field-y = secret-field.absolute-position.y;
                        AppsPageData.field-w = secret-field.width;
                        AppsPageData.field-h = secret-field.height;
                        AppsPageData.secret-value = secret-field.value;
                        secret-box.field-masked = secret-field.masked;
                    }
                }

                changed live => {
                    if index == 0 {
                        AppsPageData.secret-value = live;
                    }
                }
            }
        }

        Rectangle {
            x: 20px;
            y: parent.height - 58px;
            width: parent.width - 40px;
            height: 1px;
            background: c.divider;
        }

        HorizontalLayout {
            x: 20px;
            y: parent.height - 46px;
            width: parent.width - 40px;
            height: 30px;
            spacing: 8px;
            alignment: end;

            Btn {
                text: "取消";
                c: root.c;
                clicked => {
                    AppsPageData.cancel-dialog();
                }
            }

            clear-btn := Btn {
                text: "清除";
                c: root.c;
                clicked => {
                    AppsPageData.clear-secrets();
                }
            }

            save-btn := Btn {
                text: "保存";
                c: root.c;
                clicked => {
                    AppsPageData.save-secrets();
                }
            }
        }
    }
}
