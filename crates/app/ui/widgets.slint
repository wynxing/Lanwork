// 面板和便签悬浮窗共用的小部件。版式由这里决定，数据和动作在 Rust。

export struct Ink {
    ink: color,
    secondary: color,
    tertiary: color,
    divider: color,
    hover: color,
    selection: color,
    field: color,
    accent: color,
    critical: color,
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <color> tone;
    in property <bool> filled: false;
    in property <color> on-fill: #ffffff;

    width: label.preferred-width + 12px;
    background: transparent;

    Rectangle {
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: 20px;
        border-radius: 4px;
        background: filled ? tone : transparent;
        border-width: filled ? 0px : 1px;
        border-color: tone;

        label := Text {
            x: 6px;
            text: root.text;
            color: root.filled ? root.on-fill : root.tone;
            font-size: 11px;
            vertical-alignment: center;
            height: 100%;
        }
    }
}

export component Btn inherits Rectangle {
    in property <string> text;
    in property <Ink> c;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    callback clicked();

    height: 30px;
    width: label.preferred-width + 20px;
    border-radius: 6px;
    background: enabled && touch.has-hover ? c.hover : transparent;
    border-width: 1px;
    border-color: c.divider;

    label := Text {
        x: 10px;
        text: root.text;
        color: !enabled ? c.tertiary : danger ? c.critical : c.ink;
        font-size: 13px;
        vertical-alignment: center;
        height: 100%;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// 悬浮窗标题条上的「钉住」按钮，便签悬浮窗和收纳悬浮窗共用。只有图标，没有文字。
// 已钉住：图标实心、用强调色，底色用选中色；未钉住：只有描边的图标。
export component PinBtn inherits Rectangle {
    in property <bool> pinned;
    in property <Ink> c;
    callback toggled();

    width: 28px;
    height: 28px;
    background: pinned ? c.selection : touch.has-hover ? c.hover : transparent;
    accessible-role: button;
    accessible-label: "钉住";
    accessible-checkable: true;
    accessible-checked: pinned;

    Path {
        x: 8px;
        y: 8px;
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        fill: pinned ? c.accent : transparent;
        stroke: pinned ? c.accent : c.secondary;
        stroke-width: 1.2px;
        stroke-line-join: round;
        commands: "M4 1h4v2.2l-.8 2.4 2.2 2.1v1.1H6.6V11.5H5.4V8.8H2.6V7.7l2.2-2.1L4 3.2Z";
    }

    touch := TouchArea {
        clicked => {
            root.toggled();
        }
    }
}

// 圆形勾选框，待办页和收纳悬浮窗的关联待办共用。
export component Check inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <Ink> c;
    callback toggled();

    width: 28px;
    height: 28px;
    background: transparent;
    opacity: enabled ? 1 : 0.5;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        border-width: 1.5px;
        border-color: checked ? c.accent : c.secondary;
        background: checked ? c.accent : enabled && touch.has-hover ? c.hover : transparent;

        if checked: Path {
            width: 100%;
            height: 100%;
            viewbox-width: 18;
            viewbox-height: 18;
            fill: transparent;
            stroke: #ffffff;
            stroke-width: 1.6px;
            commands: "M5 9.3l2.7 2.7 5.2-5.4";
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.toggled();
        }
    }
}

// 单行输入。用 TextInput 而不是 LineEdit，因为要读 preedit-text：组合输入期间 Enter 不提交。
export component Field inherits Rectangle {
    in property <string> source-text;
    // 换了条目或写入成功后加一，输入框回到 source-text。
    in property <int> reset;
    in property <string> name;
    in property <Ink> c;
    in property <bool> enabled: true;
    callback committed(string);
    // 每次文字改变都调用，参数是整个文本。
    callback edited(string);
    callback escape();

    out property <bool> has-focus: input.has-focus;

    public function clear() {
        input.text = "";
    }
    public function focus-field() {
        input.focus();
    }

    height: 30px;
    border-radius: 6px;
    background: c.field;
    border-width: 1px;
    border-color: input.has-focus ? c.accent : c.divider;
    clip: true;

    init => {
        input.text = root.source-text;
    }
    changed source-text => {
        input.text = root.source-text;
    }
    changed reset => {
        input.text = root.source-text;
    }

    if input.text == "" && input.preedit-text == "" && name != "": Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: name;
        color: c.tertiary;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    clip-box := Rectangle {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        clip: true;

        input := TextInput {
            property <length> computed-x;

            x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
            width: max(parent.width - self.text-cursor-width, self.preferred-width);
            height: 100%;
            single-line: true;
            font-size: 13px;
            color: root.enabled ? c.ink : c.tertiary;
            read-only: !root.enabled;
            vertical-alignment: center;
            selection-background-color: c.accent.with-alpha(0.35);
            selection-foreground-color: c.ink;

            edited => {
                root.edited(self.text);
            }

            cursor-position-changed(cursor-position) => {
                if cursor-position.x + self.computed-x < 0px {
                    self.computed-x = -cursor-position.x;
                } else if cursor-position.x + self.computed-x > parent.width - self.text-cursor-width {
                    self.computed-x = parent.width - cursor-position.x - self.text-cursor-width;
                }
            }

            key-pressed(event) => {
                if self.preedit-text != "" {
                    return reject;
                }
                if event.text == Key.Escape {
                    root.escape();
                    return accept;
                }
                if event.text == Key.Return {
                    root.committed(self.text);
                    return accept;
                }
                reject
            }
        }
    }
}

// 几个互斥选项排成一行，当前项用选中色。
export component Segments inherits Rectangle {
    in property <[string]> items;
    in property <int> current;
    in property <Ink> c;
    callback chosen(int);

    height: 30px;
    width: row.preferred-width;
    border-radius: 6px;
    border-width: 1px;
    border-color: c.divider;
    clip: true;

    row := HorizontalLayout {
        for item[index] in items: Rectangle {
            width: label.preferred-width + 20px;
            background: index == root.current ? c.selection : touch.has-hover ? c.hover : transparent;

            label := Text {
                x: 10px;
                text: item;
                color: index == root.current ? c.accent : c.ink;
                font-size: 13px;
                font-weight: index == root.current ? 600 : 400;
                vertical-alignment: center;
                height: 100%;
            }

            touch := TouchArea {
                clicked => {
                    root.chosen(index);
                }
            }
        }
    }
}

// 开关。只显示 checked，点击时请求相反的值，不自己翻转：写盘失败时界面保持原状。
export component ToggleSwitch inherits Rectangle {
    in property <bool> checked;
    in property <Ink> c;
    in property <color> on-fill: #ffffff;
    in property <string> label;
    callback toggled(bool);

    width: 40px;
    height: 22px;
    border-radius: 11px;
    border-width: 1.5px;
    border-color: checked ? c.accent : c.secondary;
    background: checked ? c.accent : touch.has-hover ? c.hover : transparent;
    accessible-role: switch;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: checked;

    Rectangle {
        x: checked ? parent.width - self.width - 5px : 3px;
        y: (parent.height - self.height) / 2 - 1.5px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: checked ? root.on-fill : c.secondary;
    }

    touch := TouchArea {
        clicked => {
            root.toggled(!root.checked);
        }
    }
}
