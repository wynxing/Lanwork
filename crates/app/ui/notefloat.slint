// 便签悬浮窗。只有正文：上沿一条可拖动的细条，右侧是关闭，下面是正文。没有说明文字。
// 窗口始终在最上层。贴边收起时只留下一个小把手，窗口其余部分透明。风格与面板一致。

import { Palette } from "std-widgets.slint";
import { EdgeHandle, Ink } from "widgets.slint";
import { NoteEditor } from "noteeditor.slint";

export component NoteFloat inherits Window {
    title: "Lanwork";
    icon: @image-url("../assets/lanwork-256.png");
    no-frame: true;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;
    preferred-width: 320px;
    preferred-height: 360px;
    min-width: thin ? 1px : 200px;
    min-height: thin ? 1px : 120px;
    resize-border-width: thin ? 0px : 6px;
    always-on-top: true;

    in property <bool> dark;
    // 亚克力时客户区透明，DWM 画背景。
    in property <bool> acrylic;
    in property <color> solid-color: #f3f3f3;
    in property <int> problem;
    in property <string> problem-text;
    in property <bool> closing;
    // 收起或正在滑向把手时，最小尺寸放开，避免被 200px 挡住。
    in property <bool> thin;
    in property <bool> collapsed;
    // ""、"left"、"right"、"top"。
    in property <string> dock-edge;
    // 一叠的页数和当前下标。1 页时和原来的悬浮窗一样。
    in property <int> stack-pages: 1;
    in property <int> stack-index: 0;
    in-out property <string> body <=> editor.body;
    out property <string> preedit: editor.preedit;

    callback body-edited(string);
    callback close-clicked();
    callback drag-window();
    callback strip-clicked();
    // -1 向左，1 向右。正文有焦点时不调用。
    callback flip-page(int);
    callback retry();
    callback discard();
    callback keep-mine();
    callback keep-saved();

    property <Ink> c: {
        ink: dark ? #ffffff : #1b1b1b,
        secondary: dark ? #c5c5c5 : #5d5d5d,
        tertiary: dark ? #9a9a9a : #767676,
        divider: dark ? #ffffff17 : #00000014,
        hover: dark ? #ffffff0d : #00000008,
        selection: dark ? #ffffff14 : #0000000d,
        field: dark ? #ffffff0a : #ffffff80,
        accent: dark ? #60cdff : #005fb8,
        critical: dark ? #ff99a4 : #c42b1c,
    };

    // 布局检查用：关闭按钮和贴边把手在窗口里的位置。测试用来点。
    out property <length> close-x: close-box.absolute-position.x;
    out property <length> close-y: close-box.absolute-position.y;
    out property <length> strip-x: edge-strip.absolute-position.x;
    out property <length> strip-y: edge-strip.absolute-position.y;
    out property <length> strip-width: edge-strip.width;
    out property <length> strip-height: edge-strip.height;
    out property <length> grip-width: edge-strip.grip-width;
    out property <length> grip-height: edge-strip.grip-height;

    background: collapsed ? transparent : (acrylic ? transparent : solid-color);

    init => {
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark => {
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    public function focus-body() {
        editor.focus-body();
    }

    public function focus-stack-keys() {
        page-keys.focus();
    }

    page-keys := FocusScope {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if root.stack-pages > 1 && !editor.text-focused && (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                root.flip-page(event.text == Key.LeftArrow ? -1 : 1);
                return accept;
            }
            reject
        }
    }

    if !collapsed: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 28px;

        TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.focus-stack-keys();
                    root.drag-window();
                }
            }
        }
    }

    close-box := Rectangle {
        x: parent.width - 28px;
        y: 0px;
        width: 28px;
        height: 28px;
        visible: !collapsed;
        background: close-touch.has-hover ? c.hover : transparent;

        Path {
            x: 9px;
            y: 9px;
            width: 10px;
            height: 10px;
            viewbox-width: 10;
            viewbox-height: 10;
            fill: transparent;
            stroke: c.secondary;
            stroke-width: 1.2px;
            commands: "M1 1l8 8 M9 1l-8 8";
        }

        close-touch := TouchArea {
            clicked => {
                root.close-clicked();
            }
        }
    }

    // 收起时整窗就是把手。窗口由外壳收成 3×40，这里不再另铺一圈。
    if collapsed: EdgeHandle {
        x: 0px;
        y: 0px;
        dark: root.dark;
        along-vertical: dock-edge != "top";
        press-drags: true;
        pages: root.stack-pages;
        page-index: root.stack-index;
        pressed => {
            root.drag-window();
        }
    }

    // 展开并且贴边时，靠边正中的同一块把手再点一次就收回。不盖住关闭按钮。
    edge-strip := EdgeHandle {
        x: dock-edge == "right" ? parent.width - self.width : dock-edge == "top" ? (parent.width - self.width) / 2 : 0px;
        y: dock-edge == "top" ? 0px : (parent.height - self.height) / 2;
        visible: !collapsed && dock-edge != "";
        dark: root.dark;
        along-vertical: dock-edge != "top";
        clicked => {
            root.strip-clicked();
        }
    }

    editor := NoteEditor {
        visible: !root.collapsed;
        x: 10px;
        y: 28px;
        width: parent.width - 20px;
        height: parent.height - 28px - 8px;
        c: root.c;
        problem: root.problem;
        problem-text: root.problem-text;
        closing: root.closing;
        body-edited(text) => {
            root.body-edited(text);
        }
        retry => {
            root.retry();
        }
        discard => {
            root.discard();
        }
        keep-mine => {
            root.keep-mine();
        }
        keep-saved => {
            root.keep-saved();
        }
    }
}
