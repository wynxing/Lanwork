// 收纳分组悬浮窗。拖动条、关闭、来源行和贴边把手在共用的 FloatChrome 里。
// 没有钉住按钮，窗口始终在最上层。来源行下面仍是「关联待办」，再下面是条目。
// 条目列表和面板的收纳页是同一个组件。

import { ListView } from "std-widgets.slint";
import { FloatChrome } from "float_shell.slint";
import { Btn, Check, Ink } from "widgets.slint";
import { RefsList, ShelvesPageData } from "shelvespage.slint";

export component ShelfFloat inherits Window {
    title: "Lanwork";
    icon: @image-url("../assets/lanwork-256.png");
    no-frame: true;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;
    preferred-width: 320px;
    preferred-height: 360px;
    min-width: thin ? 1px : min(200px, limit-width);
    min-height: thin ? 1px : min(120px, limit-height);
    in property <length> limit-width: 100000px;
    in property <length> limit-height: 100000px;
    max-width: thin ? 100000px : limit-width;
    max-height: thin ? 100000px : limit-height;
    resize-border-width: thin ? 0px : 6px;
    always-on-top: true;

    in property <bool> dark;
    in property <bool> acrylic;
    in property <color> solid-color: #f3f3f3;
    in property <string> error;
    in property <bool> thin;
    in property <bool> collapsed;
    // ""、"left"、"right"、"top"。
    in property <string> dock-edge;
    in property <int> stack-pages: 1;
    in property <int> stack-index: 0;
    in property <string> source;

    callback close-clicked();
    callback drag-requested();
    callback strip-clicked();
    callback flip-page(int);

    property <Ink> c: chrome.c;
    property <int> link-rows: min(ShelvesPageData.links.length, 4);
    // 收起时只有标题行；展开后是 1 到 4 行列表，没有关联时一行说明。
    property <length> links-height: ShelvesPageData.links-open ? 28px + max(link-rows, 1) * 30px : 28px;
    // 选中条目时底部多一行：完整路径和「移除引用」。
    property <length> action-height: ShelvesPageData.selected-ref >= 0 ? 34px : 0px;
    property <length> error-height: root.error != "" ? 24px : 0px;

    // 布局检查用：各块的屏幕位置。父元素高度一变，没写 y 的子元素会跟着居中，所以每个都写了 y。
    out property <length> links-head-y: links-head-box.absolute-position.y;
    out property <length> links-head-height: links-head-box.height;
    out property <length> links-body-y: links-body.absolute-position.y;
    out property <length> links-body-height: links-body.height;
    out property <length> refs-area-y: refs-area.absolute-position.y;
    out property <length> refs-area-height: refs-area.height;
    out property <length> action-y: action-bar.absolute-position.y;
    out property <length> close-x: chrome.close-x;
    out property <length> close-y: chrome.close-y;
    out property <length> strip-x: chrome.strip-x;
    out property <length> strip-y: chrome.strip-y;
    out property <length> strip-width: chrome.strip-width;
    out property <length> strip-height: chrome.strip-height;
    out property <length> grip-width: chrome.grip-width;
    out property <length> grip-height: chrome.grip-height;
    out property <length> source-y: chrome.source-y;
    out property <length> source-h: chrome.source-h;
    out property <bool> source-open: chrome.source-open;

    background: collapsed ? transparent : (acrylic ? transparent : solid-color);

    init => {
        float-scope.focus();
    }

    public function focus-float() {
        float-scope.focus();
    }

    chrome := FloatChrome {
        dark: root.dark;
        collapsed: root.collapsed;
        dock-edge: root.dock-edge;
        source: root.source;
        stack-pages: root.stack-pages;
        stack-index: root.stack-index;
        show-pin: false;
        show-source: true;
        error-in-chrome: false;

        close-clicked => {
            root.close-clicked();
        }
        drag-requested => {
            root.drag-requested();
        }
        strip-clicked => {
            root.strip-clicked();
        }

        Rectangle {
            x: 10px;
            y: 0px;
            width: parent.width - 20px;
            height: links-height;
            clip: true;

            links-head-box := Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 28px;
                border-radius: 6px;
                background: links-head.has-hover ? root.c.hover : transparent;

                links-head := TouchArea {
                    clicked => {
                        ShelvesPageData.links-open = !ShelvesPageData.links-open;
                        float-scope.focus();
                    }
                }

                Path {
                    x: 6px;
                    y: 9px;
                    width: 10px;
                    height: 10px;
                    viewbox-width: 10;
                    viewbox-height: 10;
                    fill: transparent;
                    stroke: root.c.secondary;
                    stroke-width: 1.4px;
                    commands: ShelvesPageData.links-open ? "M1 3l4 4 4-4" : "M3 1l4 4-4 4";
                }

                Text {
                    x: 24px;
                    y: 0px;
                    width: parent.width - 24px - 6px;
                    height: 28px;
                    text: ShelvesPageData.links.length > 0 ? "关联待办（" + ShelvesPageData.links.length + "）" : "关联待办";
                    color: root.c.secondary;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            links-body := Rectangle {
                x: 0px;
                y: 28px;
                width: parent.width;
                height: ShelvesPageData.links-open ? max(link-rows, 1) * 30px : 0px;
                clip: true;

                if ShelvesPageData.links.length == 0: Text {
                    x: 24px;
                    y: 0px;
                    width: parent.width - 24px;
                    height: 30px;
                    text: "没有关联待办";
                    color: root.c.tertiary;
                    font-size: 13px;
                    vertical-alignment: center;
                }

                if ShelvesPageData.links.length > 0: ListView {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;

                    for link[index] in ShelvesPageData.links: Rectangle {
                        height: 30px;

                        HorizontalLayout {
                            padding-left: 4px;
                            spacing: 4px;

                            Check {
                                c: root.c;
                                checked: link.completed;
                                enabled: link.found && !link.completed && !link.in-trash;
                                toggled => {
                                    ShelvesPageData.complete-todo(index);
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;

                                TouchArea {
                                    enabled: link.found;
                                    mouse-cursor: link.found ? MouseCursor.pointer : MouseCursor.default;
                                    clicked => {
                                        ShelvesPageData.open-todo(index);
                                    }
                                }

                                Text {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width;
                                    height: parent.height;
                                    text: link.found ? link.title : "找不到这条待办";
                                    color: !link.found || link.completed || link.in-trash ? root.c.tertiary : root.c.ink;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }

        refs-area := Rectangle {
            x: 10px;
            y: links-height;
            width: parent.width - 20px;
            // `@children` 的 parent.height 是整窗。y 已经相对内容槽，高度按窗口减去拖动条和来源行。
            height: root.height - 28px - 20px - links-height - 8px - error-height - action-height;

            if ShelvesPageData.refs.length == 0: Text {
                x: 4px;
                y: 4px;
                text: "没有条目";
                color: root.c.secondary;
                font-size: 14px;
            }

            RefsList {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                c: root.c;
                focus-requested => {
                    float-scope.focus();
                }
            }
        }

        // 选中条目时：完整路径和「移除引用」。触发方式沿用面板的按钮，不加 Delete 键或右键。
        action-bar := Rectangle {
            x: 10px;
            y: root.height - 28px - 20px - error-height - 4px - action-height;
            width: parent.width - 20px;
            height: action-height;

            if ShelvesPageData.selected-ref >= 0: HorizontalLayout {
                spacing: 8px;
                padding-top: 2px;
                padding-bottom: 2px;

                Text {
                    horizontal-stretch: 1;
                    text: ShelvesPageData.selected-path;
                    color: root.c.secondary;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Btn {
                    text: "移除引用";
                    c: root.c;
                    danger: true;
                    clicked => {
                        ShelvesPageData.remove-ref();
                        float-scope.focus();
                    }
                }
            }
        }

        if root.error != "": Text {
            x: 10px;
            y: root.height - 28px - 20px - error-height - 4px;
            width: parent.width - 20px;
            height: error-height;
            text: root.error;
            color: root.c.critical;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // 收起时内容槽藏起来。翻页和 Enter 留在窗口上。
    float-scope := FocusScope {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;

        key-pressed(event) => {
            if root.stack-pages > 1 && (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                root.flip-page(event.text == Key.LeftArrow ? -1 : 1);
                return accept;
            }
            if ShelvesPageData.selected-ref >= 0 && event.text == Key.Return {
                if event.modifiers.control {
                    ShelvesPageData.open-ref-folder();
                } else {
                    ShelvesPageData.open-ref();
                }
                return accept;
            }
            reject
        }
    }
}
