// 收纳分组的悬浮窗。只显示该分组的条目：上沿一条可拖动的细条，右侧是关闭，下面是条目列表。
// 窗口始终在最上层。贴边收起时只留下一个小把手，窗口其余部分透明。条目列表和面板的收纳页是同一个组件。

import { ListView, Palette } from "std-widgets.slint";
import { Btn, Check, EdgeHandle, Ink } from "widgets.slint";
import { RefsList, ShelvesPageData } from "shelvespage.slint";

export component ShelfFloat inherits Window {
    title: "Lanwork";
    icon: @image-url("../assets/lanwork-256.png");
    no-frame: true;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;
    preferred-width: 320px;
    preferred-height: 360px;
    min-width: thin ? 1px : 200px;
    min-height: thin ? 1px : 120px;
    resize-border-width: thin ? 0px : 6px;
    always-on-top: true;

    in property <bool> dark;
    // 亚克力时客户区透明，DWM 画背景。
    in property <bool> acrylic;
    in property <color> solid-color: #f3f3f3;
    in property <string> error;
    in property <bool> thin;
    in property <bool> collapsed;
    // ""、"left"、"right"、"top"。
    in property <string> dock-edge;
    in property <int> stack-pages: 1;
    in property <int> stack-index: 0;

    callback close-clicked();
    callback drag-window();
    callback strip-clicked();
    callback flip-page(int);

    property <Ink> c: {
        ink: dark ? #ffffff : #1b1b1b,
        secondary: dark ? #c5c5c5 : #5d5d5d,
        tertiary: dark ? #9a9a9a : #767676,
        divider: dark ? #ffffff17 : #00000014,
        hover: dark ? #ffffff0d : #00000008,
        selection: dark ? #ffffff14 : #0000000d,
        field: dark ? #ffffff0a : #ffffff80,
        accent: dark ? #60cdff : #005fb8,
        critical: dark ? #ff99a4 : #c42b1c,
    };
    property <length> error-height: error != "" ? 24px : 0px;
    property <int> link-rows: min(ShelvesPageData.links.length, 4);
    // 收起时只有标题行；展开后是 1 到 4 行列表，没有关联时一行说明。
    property <length> links-height: ShelvesPageData.links-open ? 28px + max(link-rows, 1) * 30px : 28px;
    // 选中条目时底部多一行：完整路径和「移除引用」。
    property <length> action-height: ShelvesPageData.selected-ref >= 0 ? 34px : 0px;

    // 布局检查用：各块的屏幕位置，测试据此确认互不重叠。Slint 里没有显式 x、y 的子元素会在
    // 父元素里居中，父元素高度一变它就跟着动，所以这里每个子元素都写了 y。
    out property <length> links-head-y: links-head-box.absolute-position.y;
    out property <length> links-head-height: links-head-box.height;
    out property <length> links-body-y: links-body.absolute-position.y;
    out property <length> links-body-height: links-body.height;
    out property <length> refs-area-y: refs-area.absolute-position.y;
    out property <length> refs-area-height: refs-area.height;
    out property <length> action-y: action-bar.absolute-position.y;
    out property <length> close-x: close-box.absolute-position.x;
    out property <length> strip-x: edge-strip.absolute-position.x;
    out property <length> strip-y: edge-strip.absolute-position.y;
    out property <length> strip-width: edge-strip.width;
    out property <length> strip-height: edge-strip.height;
    out property <length> grip-width: edge-strip.grip-width;
    out property <length> grip-height: edge-strip.grip-height;

    background: collapsed ? transparent : (acrylic ? transparent : solid-color);

    init => {
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
        float-scope.focus();
    }
    changed dark => {
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    public function focus-float() {
        float-scope.focus();
    }

    float-scope := FocusScope {
        key-pressed(event) => {
            if root.stack-pages > 1 && (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                root.flip-page(event.text == Key.LeftArrow ? -1 : 1);
                return accept;
            }
            if ShelvesPageData.selected-ref >= 0 && event.text == Key.Return {
                if event.modifiers.control {
                    ShelvesPageData.open-ref-folder();
                } else {
                    ShelvesPageData.open-ref();
                }
                return accept;
            }
            reject
        }

        if !root.collapsed: Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 28px;

            TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        float-scope.focus();
                        root.drag-window();
                    }
                }
            }
        }

        close-box := Rectangle {
            x: parent.width - 28px;
            y: 0px;
            width: 28px;
            height: 28px;
            visible: !root.collapsed;
            background: close-touch.has-hover ? c.hover : transparent;

            Path {
                x: 9px;
                y: 9px;
                width: 10px;
                height: 10px;
                viewbox-width: 10;
                viewbox-height: 10;
                fill: transparent;
                stroke: c.secondary;
                stroke-width: 1.2px;
                commands: "M1 1l8 8 M9 1l-8 8";
            }

            close-touch := TouchArea {
                clicked => {
                    root.close-clicked();
                }
            }
        }

        if root.collapsed: EdgeHandle {
            x: 0px;
            y: 0px;
            dark: root.dark;
            along-vertical: dock-edge != "top";
            press-drags: true;
            pages: root.stack-pages;
            page-index: root.stack-index;
            pressed => {
                root.drag-window();
            }
        }

        edge-strip := EdgeHandle {
            x: dock-edge == "right" ? parent.width - self.width : dock-edge == "top" ? (parent.width - self.width) / 2 : 0px;
            y: dock-edge == "top" ? 0px : (parent.height - self.height) / 2;
            visible: !root.collapsed && dock-edge != "";
            dark: root.dark;
            along-vertical: dock-edge != "top";
            clicked => {
                root.strip-clicked();
            }
        }

        Rectangle {
            visible: !root.collapsed;
            x: 10px;
            y: 28px;
            width: parent.width - 20px;
            height: links-height;
            clip: true;

            links-head-box := Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 28px;
                border-radius: 6px;
                background: links-head.has-hover ? c.hover : transparent;

                links-head := TouchArea {
                    clicked => {
                        ShelvesPageData.links-open = !ShelvesPageData.links-open;
                        float-scope.focus();
                    }
                }

                Path {
                    x: 6px;
                    y: 9px;
                    width: 10px;
                    height: 10px;
                    viewbox-width: 10;
                    viewbox-height: 10;
                    fill: transparent;
                    stroke: c.secondary;
                    stroke-width: 1.4px;
                    commands: ShelvesPageData.links-open ? "M1 3l4 4 4-4" : "M3 1l4 4-4 4";
                }

                Text {
                    x: 24px;
                    y: 0px;
                    width: parent.width - 24px - 6px;
                    height: 28px;
                    text: ShelvesPageData.links.length > 0 ? "关联待办（" + ShelvesPageData.links.length + "）" : "关联待办";
                    color: c.secondary;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            links-body := Rectangle {
                x: 0px;
                y: 28px;
                width: parent.width;
                height: ShelvesPageData.links-open ? max(link-rows, 1) * 30px : 0px;
                clip: true;

                if ShelvesPageData.links.length == 0: Text {
                    x: 24px;
                    y: 0px;
                    width: parent.width - 24px;
                    height: 30px;
                    text: "没有关联待办";
                    color: c.tertiary;
                    font-size: 13px;
                    vertical-alignment: center;
                }

                if ShelvesPageData.links.length > 0: ListView {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;

                    for link[index] in ShelvesPageData.links: Rectangle {
                        height: 30px;

                        HorizontalLayout {
                            padding-left: 4px;
                            spacing: 4px;

                            Check {
                                c: root.c;
                                checked: link.completed;
                                enabled: link.found && !link.completed && !link.in-trash;
                                toggled => {
                                    ShelvesPageData.complete-todo(index);
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;

                                TouchArea {
                                    enabled: link.found;
                                    mouse-cursor: link.found ? MouseCursor.pointer : MouseCursor.default;
                                    clicked => {
                                        ShelvesPageData.open-todo(index);
                                    }
                                }

                                Text {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width;
                                    height: parent.height;
                                    text: link.found ? link.title : "找不到这条待办";
                                    color: !link.found || link.completed || link.in-trash ? c.tertiary : c.ink;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }

        refs-area := Rectangle {
            visible: !root.collapsed;
            x: 10px;
            y: 28px + links-height;
            width: parent.width - 20px;
            height: parent.height - 28px - links-height - 8px - error-height - action-height;

            if ShelvesPageData.refs.length == 0: Text {
                x: 4px;
                y: 4px;
                text: "没有条目";
                color: c.secondary;
                font-size: 14px;
            }

            RefsList {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                c: root.c;
                focus-requested => {
                    float-scope.focus();
                }
            }
        }

        // 选中条目时：完整路径和「移除引用」。触发方式沿用面板的按钮，不加 Delete 键或右键。
        action-bar := Rectangle {
            visible: !root.collapsed;
            x: 10px;
            y: parent.height - error-height - 4px - action-height;
            width: parent.width - 20px;
            height: action-height;

            if ShelvesPageData.selected-ref >= 0: HorizontalLayout {
                spacing: 8px;
                padding-top: 2px;
                padding-bottom: 2px;

                Text {
                    horizontal-stretch: 1;
                    text: ShelvesPageData.selected-path;
                    color: c.secondary;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Btn {
                    text: "移除引用";
                    c: root.c;
                    danger: true;
                    clicked => {
                        ShelvesPageData.remove-ref();
                        float-scope.focus();
                    }
                }
            }
        }

        if !root.collapsed && error != "": Text {
            x: 10px;
            y: parent.height - error-height - 4px;
            width: parent.width - 20px;
            height: error-height;
            text: root.error;
            color: c.critical;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
