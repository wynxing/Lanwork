import { Palette } from "std-widgets.slint";

// 搜索条和面板的宿主。可见内容分别由后续界面实现。这里不放输入框，也不放说明文字。
export component SearchHost inherits Window {
    title: "Lanwork";
    public function apply-theme(dark: bool) {
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }
}

export component PanelHost inherits Window {
    title: "Lanwork";
    public function apply-theme(dark: bool) {
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }
}

export component Tray inherits SystemTrayIcon {
    // 逾期数字画在这张图上。数量为 0 时图里没有数字。
    in-out property <image> badge-icon;
    icon: badge-icon;
    tooltip: "Lanwork";
    visible: true;

    callback open-panel();
    callback open-settings();
    callback new-note();
    callback refresh-github();
    callback quit();

    Menu {
        MenuItem {
            title: "打开面板";
            activated => { root.open-panel(); }
        }
        MenuItem {
            title: "设置";
            activated => { root.open-settings(); }
        }
        MenuItem {
            title: "新建便签";
            activated => { root.new-note(); }
        }
        MenuItem {
            title: "刷新 GitHub";
            activated => { root.refresh-github(); }
        }
        MenuItem {
            title: "退出";
            activated => { root.quit(); }
        }
    }
}
