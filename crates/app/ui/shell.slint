export { SearchBar, BarRow } from "searchbar.slint";
export { Panel, PanelRow, PanelList, PanelDetail } from "panel.slint";
export { NoteListRow, NotesPageData, TagFilter } from "notespage.slint";
export { ShelfGroupRow, ShelfLinkRow, ShelfRefRow, ShelfTodoRow, ShelvesPageData } from "shelvespage.slint";
export { SettingsPageData } from "settingspage.slint";
export { FloatShell, FloatShellProbe } from "float_shell.slint";
export { NoteFloat } from "notefloat.slint";
export { ShelfFloat } from "shelffloat.slint";
export { TodoFloat, TodoFloatRow } from "todofloat.slint";
export { StackTab } from "stacktab.slint";

export component Tray inherits SystemTrayIcon {
    // 底图是应用图标。逾期数字画在右下角的徽章上。数量为 0 时没有徽章。
    in-out property <image> badge-icon;
    icon: badge-icon;
    tooltip: "Lanwork";
    visible: true;

    callback open-panel();
    callback open-settings();
    callback new-note();
    callback quit();

    Menu {
        MenuItem {
            title: "打开面板";
            activated => { root.open-panel(); }
        }
        MenuItem {
            title: "设置";
            activated => { root.open-settings(); }
        }
        MenuItem {
            title: "新建便签";
            activated => { root.new-note(); }
        }
        MenuItem {
            title: "退出";
            activated => { root.quit(); }
        }
    }
}
