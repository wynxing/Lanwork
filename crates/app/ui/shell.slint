export { SearchBar, BarRow } from "searchbar.slint";
export { Panel, PanelRow, PanelList, PanelDetail } from "panel.slint";
export { NoteListRow, NotesPageData, TagFilter } from "notespage.slint";
export { NoteFloat } from "notefloat.slint";

export component Tray inherits SystemTrayIcon {
    // 逾期数字画在这张图上。数量为 0 时图里没有数字。
    in-out property <image> badge-icon;
    icon: badge-icon;
    tooltip: "Lanwork";
    visible: true;

    callback open-panel();
    callback open-settings();
    callback new-note();
    callback refresh-github();
    callback quit();

    Menu {
        MenuItem {
            title: "打开面板";
            activated => { root.open-panel(); }
        }
        MenuItem {
            title: "设置";
            activated => { root.open-settings(); }
        }
        MenuItem {
            title: "新建便签";
            activated => { root.new-note(); }
        }
        MenuItem {
            title: "刷新 GitHub";
            activated => { root.refresh-github(); }
        }
        MenuItem {
            title: "退出";
            activated => { root.quit(); }
        }
    }
}
